# SQLCC Storage Engine Header Files Package

package(default_visibility = ["//visibility:public"])

# Main storage engine header
cc_library(
    name = "storage_engine",
    hdrs = ["storage_engine.h"],
    deps = [
        "//src/exception:exception",
        "//include/page:page",
    ],
    visibility = ["//visibility:public"],
)

# Table storage headers
cc_library(
    name = "record_validator",
    hdrs = ["//include/storage_engine/table_storage:record_validator.h"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "page_raii",
    hdrs = ["//include/storage_engine/table_storage:page_raii.h"],
    deps = [
        "//include/page:page",
        "//src/exception:exception",
    ],
    visibility = ["//visibility:public"],
)

# Table storage headers
cc_library(
    name = "table_storage_headers",
    hdrs = glob(["table_storage/*.h"], allow_empty = True),
    deps = [
        "//include/page:page",
        "//src/exception:exception",
    ],
    visibility = ["//visibility:public"],
)

# All storage engine headers
cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
    deps = [
        "//src/exception:exception",
        "//include/page:page",
    ],
    visibility = ["//visibility:public"],
)

# All storage engine headers (alias for backward compatibility)
cc_library(
    name = "all_headers",
    hdrs = glob(["**/*.h"]),
    deps = [
        "//src/exception:exception",
        "//include/page:page",
    ],
    visibility = ["//visibility:public"],
)
