# SQLCC存储引擎头文件库定义

package(default_visibility = ["//visibility:public"])

# 并发控制头文件库
filegroup(
    name = "concurrency_control_headers",
    srcs = ["concurrency_control.h"],
)

# 替换策略头文件库
filegroup(
    name = "replace_strategy_headers",
    srcs = ["replace_strategy.h"],
)

# LazyWriter头文件库
filegroup(
    name = "lazy_writer_hdr",
    srcs = ["lazy_writer.h"],
)

# 存储引擎头文件集合
filegroup(
    name = "storage_headers",
    srcs = glob(["*.h"]),
)

# 存储引擎头文件库（供其他模块使用）
cc_library(
    name = "storage_headers_lib",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

# 分区管理器头文件目标
cc_library(
    name = "partition_manager",
    hdrs = ["partition_manager.h"],
    visibility = ["//visibility:public"],
)

# 缓冲池头文件目标
cc_library(
    name = "buffer_pool",
    hdrs = ["buffer_pool.h"],
    visibility = ["//visibility:public"],
)

# 缓冲池头文件目标
cc_library(
    name = "buffer_pool_sharded",
    hdrs = ["buffer_pool_sharded.h"],
    visibility = ["//visibility:public"],
)

# 表存储头文件目标
cc_library(
    name = "table_storage",
    hdrs = ["table_storage.h"],
    visibility = ["//visibility:public"],
)

# 索引管理器头文件目标
cc_library(
    name = "index_manager",
    hdrs = ["index_manager.h"],
    visibility = ["//visibility:public"],
)

# 磁盘管理器头文件目标
cc_library(
    name = "disk_manager",
    hdrs = ["disk_manager.h"],
    visibility = ["//visibility:public"],
)

# -----------------------------------------------------------------------------
# 综合头文件库 - 所有 storage 头文件的集合
# -----------------------------------------------------------------------------

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)
