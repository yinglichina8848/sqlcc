# 覆盖率工具库 (供其他目标使用)
filegroup(
    name = "coverage_tools",
    srcs = glob([
        "scripts/*coverage*",
        "scripts/enhanced_coverage_analyzer.py",
        "scripts/test_status_tracker.py",
        "scripts/sqlcc_test_system.py",
        "scripts/generate_test_report.py",
        "scripts/memory_audit.py",
    ]),
    visibility = ["//visibility:public"],
)

# 覆盖率配置模板
filegroup(
    name = "coverage_templates",
    srcs = [
        "tools/bazel_coverage_build_template.bzl",
        "docs/guides/COVERAGE_TEST_GUIDE.md",
    ],
    visibility = ["//visibility:public"],
)

# 覆盖率测试别名 (方便使用)
alias(
    name = "test_coverage",
    actual = ":coverage_test",
)

alias(
    name = "coverage_basic",
    actual = select({
        ":coverage_mode_basic": ":coverage_test",
    }),
)

alias(
    name = "coverage_comprehensive",
    actual = select({
        ":coverage_mode_comprehensive": ":coverage_test",
    }),
)

alias(
    name = "coverage_report",
    actual = ":generate_coverage_reports",
)

alias(
    name = "coverage_quality_check",
    actual = ":coverage_quality_gate",
)

# CI/CD 集成目标
test_suite(
    name = "coverage_ci",
    tests = [
        ":coverage_test",
        ":coverage_quality_gate",
        ":verify_coverage",
    ],
    tags = ["ci", "coverage"],
)

# 开发人员常用目标
test_suite(
    name = "coverage_dev",
    tests = [
        ":coverage_test",
        ":coverage_trend_analysis",
        ":generate_coverage_reports",
    ],
    tags = ["dev", "coverage"],
)