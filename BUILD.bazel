# SQLCC根目录BUILD.bazel - 主应用和测试套件定义
# 遵循设计文档的包层次结构，引用子包目标

package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")


# 导出include目录的头文件，使其对其他包可见
exports_files(
    glob(["include/**/*.h"], allow_empty = True),
    visibility = ["//visibility:public"],
)



# ==================== 主应用程序 ====================

# SQLCC服务器端程序 - 引用子包目标
cc_binary(
    name = "sqlcc",
    srcs = ["//src/sqlcc_server:server_main.cpp"],
    deps = [
        "//src/core:core",
        "//src/utils:utils",
        "//src/network:network",
        "//src/storage_engine:storage_engine",
        "//src/sql_parser:sql_parser",
        "//src/logger:logger",
        "//src/sql_executor:sql_executor",
        "//src/execution:execution",
        "//src/procedure:procedure",
        "//src/trigger:trigger",
        "//src/transaction:transaction",
        "//src/types:types",
        "//src/security:security",
    ],
    includes = ["include"],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
        "-lssl",
        "-lcrypto",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
)

# ISQL客户端程序 - 引用子包目标
cc_binary(
    name = "isql",
    deps = [
        "//src/isql_network:isql_network_lib",
        "//src/network:network",
        "//src/core:core",
        "//src/sql_executor:sql_executor",
        "//src/logger:logger",
        "//src/utils:utils",
    ],
    includes = ["include"],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
        "-lssl",
        "-lcrypto",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
)

# ==================== 调试工具 ====================

# 调试B+树程序
cc_binary(
    name = "debug_bplus_tree",
    srcs = ["debug_bplus_tree.cpp"],
    deps = [
        "//src/storage_engine:storage_engine",
        "//src/logger:logger",
    ],
    includes = ["include"],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
)

# ==================== C++20 Modules 测试 ====================

# C++20 Logger模块测试
cc_binary(
    name = "test_logger_module",
    srcs = [
        "test_logger_module.cpp",
    ],
    data = [
        "//include/utils:logger",
        "//src/utils:logger_module",
    ],
    copts = [
        "-std=c++20",
        "-fmodules-ts",  # GCC/Clang modules标志
    ],
    features = ["cpp20_modules"],
)

# ==================== SQL执行器功能测试 ====================

# SQL Executor功能测试
cc_binary(
    name = "test_sql_executor",
    srcs = ["test_sql_executor.cpp"],
    deps = ["//include:sql_executor"],
    includes = ["include"],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
)

# ==================== 网络测试程序 ====================
