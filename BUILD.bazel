# SQLCC 统一覆盖率测试系统
# 整合所有覆盖率相关脚本，提供统一的测试和分析接口

load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@bazel_skylib//lib:selects.bzl", "selects")

# 覆盖率模式配置
string_flag(
    name = "coverage_mode",
    build_setting_default = "basic",
    values = [
        "basic",       # 基础覆盖率测试
        "comprehensive", # 综合覆盖率测试 (Level 1-6)
        "incremental", # 增量覆盖率测试
        "performance", # 性能覆盖率测试
        "security",    # 安全覆盖率测试
    ],
)

# 覆盖率输出格式配置
string_flag(
    name = "coverage_format",
    build_setting_default = "html",
    values = [
        "html",     # HTML报告
        "lcov",     # LCOV格式
        "json",     # JSON格式
        "text",     # 文本格式
        "all",      # 所有格式
    ],
)

# 覆盖率分析深度配置
string_flag(
    name = "coverage_depth",
    build_setting_default = "module",
    values = [
        "file",     # 文件级分析
        "function", # 函数级分析
        "module",   # 模块级分析
        "component", # 组件级分析
        "system",   # 系统级分析
    ],
)

# 覆盖率阈值配置 (用于质量门禁)
string_flag(
    name = "coverage_threshold",
    build_setting_default = "70",
    values = [
        "50", "60", "70", "75", "80", "85", "90", "95",
    ],
)

# 统一的覆盖率测试目标
sh_test(
    name = "coverage_test",
    srcs = ["scripts/run_unified_coverage.sh"],
    data = glob([
        "scripts/*coverage*",
        "scripts/enhanced_coverage_analyzer.py",
        "scripts/test_status_tracker.py",
        "scripts/sqlcc_test_system.py",
        "scripts/generate_test_report.py",
        "scripts/memory_audit.py",
        "scripts/fix_bazel_paths.py",
        "scripts/fix_include_paths.py",
        "scripts/sync_document_versions.py",
    ]),
    args = select({
        ":coverage_mode_basic": ["--mode", "basic"],
        ":coverage_mode_comprehensive": ["--mode", "comprehensive"],
        ":coverage_mode_incremental": ["--mode", "incremental"],
        ":coverage_mode_performance": ["--mode", "performance"],
        ":coverage_mode_security": ["--mode", "security"],
    }) + select({
        ":coverage_format_html": ["--format", "html"],
        ":coverage_format_lcov": ["--format", "lcov"],
        ":coverage_format_json": ["--format", "json"],
        ":coverage_format_text": ["--format", "text"],
        ":coverage_format_all": ["--format", "all"],
    }) + select({
        ":coverage_depth_file": ["--depth", "file"],
        ":coverage_depth_function": ["--depth", "function"],
        ":coverage_depth_module": ["--depth", "module"],
        ":coverage_depth_component": ["--depth", "component"],
        ":coverage_depth_system": ["--depth", "system"],
    }),
    timeout = "long",
    tags = ["coverage", "manual"],
    env = {
        "COVERAGE_MODE": "$(COVERAGE_MODE)",
        "COVERAGE_FORMAT": "$(COVERAGE_FORMAT)",
        "COVERAGE_DEPTH": "$(COVERAGE_DEPTH)",
        "COVERAGE_THRESHOLD": "$(COVERAGE_THRESHOLD)",
        "PROJECT_ROOT": "$(location :BUILD.bazel)",
    },
)

# 覆盖率质量门禁检查
sh_test(
    name = "coverage_quality_gate",
    srcs = ["scripts/check_coverage_quality.sh"],
    data = glob([
        "scripts/*coverage*",
        "scripts/enhanced_coverage_analyzer.py",
        "coverage_reports/**/*",
    ], allow_empty = True),
    args = [
        "--threshold", "$(COVERAGE_THRESHOLD)",
        "--reports-dir", "$(location coverage_reports)",
    ],
    timeout = "short",
    tags = ["coverage", "quality_gate"],
)

# 覆盖率趋势分析目标
sh_test(
    name = "coverage_trend_analysis",
    srcs = ["scripts/analyze_coverage_trends.sh"],
    data = glob([
        "coverage_reports/**/*",
        "docs/**/*",
    ], allow_empty = True),
    timeout = "medium",
    tags = ["coverage", "analysis"],
)

# 覆盖率报告生成目标
sh_test(
    name = "generate_coverage_reports",
    srcs = ["scripts/generate_unified_coverage_report.sh"],
    data = glob([
        "scripts/*coverage*",
        "coverage_data/**/*",
        "coverage_reports/**/*",
    ], allow_empty = True),
    timeout = "medium",
    tags = ["coverage", "reporting"],
)

# 覆盖率数据收集目标
sh_test(
    name = "collect_coverage_data",
    srcs = ["scripts/collect_unified_coverage_data.sh"],
    data = glob([
        "scripts/collect_*",
        "tests/**/*",
    ]),
    timeout = "long",
    tags = ["coverage", "collection"],
)

# 覆盖率验证目标
sh_test(
    name = "verify_coverage",
    srcs = ["scripts/verify_coverage_integrity.sh"],
    data = glob([
        "scripts/verify_*",
        "coverage_data/**/*",
        "coverage_reports/**/*",
    ], allow_empty = True),
    timeout = "medium",
    tags = ["coverage", "verification"],
)

# 覆盖率基准测试目标
sh_test(
    name = "coverage_benchmark",
    srcs = ["scripts/benchmark_coverage_performance.sh"],
    data = glob([
        "scripts/benchmark_*",
        "tests/**/*",
    ]),
    timeout = "long",
    tags = ["coverage", "benchmark", "performance"],
)

# 覆盖率自动化流水线目标
sh_test(
    name = "coverage_pipeline",
    srcs = ["scripts/coverage_pipeline.sh"],
    data = glob([
        "scripts/**/*",
        "tests/**/*",
        "src/**/*",
        "include/**/*",
    ]),
    timeout = "long",
    tags = ["coverage", "pipeline", "ci"],
)

