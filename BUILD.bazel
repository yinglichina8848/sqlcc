# 根目录BUILD.bazel文件 - 定义整个项目的构建规则

package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

# ==================== 库定义 ====================

# 执行上下文库
cc_library(
    name = "execution_context",
    srcs = ["//src:execution_context.cpp"],
    hdrs = ["//include:execution_context.h"],
    includes = ["include", "include/core"],
    deps = [
        "//src/core:sqlcc_core_lib",
        "@com_google_absl//absl/strings",
    ],
)

# 执行引擎库
cc_library(
    name = "execution_engine",
    srcs = ["//src:execution_engine.cpp"],
    hdrs = ["//include:execution_engine.h"],
    includes = ["include", "include/core", "include/storage"],
    deps = [
        "//src/core:sqlcc_core_lib",
        "//src/sql_executor:sqlcc_executor",
        "//src/sql_parser:sqlcc_parser",
        "@com_google_absl//absl/strings",
    ],
)

# 统一执行器库
cc_library(
    name = "unified_executor",
    srcs = ["//src:unified_executor.cpp"],
    hdrs = ["//include:unified_executor.h"],
    includes = ["include", "include/core", "include/storage"],
    deps = [
        "//src/core:sqlcc_core_lib",
        "//src/sql_executor:sqlcc_executor",
        "//src/sql_parser:sqlcc_parser",
        "@com_google_absl//absl/strings",
    ],
)

# ==================== 测试定义 ====================

# 核心组件测试套件
cc_test(
    name = "core_component_tests",
    size = "medium",
    srcs = [],
    deps = [
        ":sqlcc_core",
        "@com_google_googletest//:gtest_main",
    ],
)

# ==================== 可执行文件定义 ====================

# 调试解析器
cc_binary(
    name = "debug_parser",
    srcs = ["debug_parser.cpp"],
    deps = [
        "//src/sql_parser:sqlcc_parser",
    ],
)

# ==================== 测试套件 ====================

# 核心组件测试套件
test_suite(
    name = "core_tests",
    tests = [
        "//src:core_component_tests",
    ],
)

# 解析器组件测试套件
test_suite(
    name = "parser_tests",
    tests = [
        "//tests/components/parser:parser_component_tests",
    ],
)

# 执行器组件测试套件
test_suite(
    name = "executor_tests",
    tests = [
        "//tests/components/executor:executor_component_tests",
    ],
)

# 存储组件测试套件
test_suite(
    name = "storage_tests",
    tests = [
        "//tests/components/storage:storage_component_tests",
    ],
)

# 网络组件测试套件
test_suite(
    name = "network_tests",
    tests = [
        "//tests/components/network:network_component_tests",
    ],
)

# 安全组件测试套件
test_suite(
    name = "security_tests",
    tests = [
        "//tests/components/security:security_component_tests",
    ],
)

# 事务组件测试套件
test_suite(
    name = "transaction_tests",
    tests = [
        "//tests/components/transaction:transaction_component_tests",
    ],
)

# 所有测试套件
test_suite(
    name = "all_tests",
    tests = [
        ":core_tests",
        ":parser_tests",
        ":executor_tests",
        ":storage_tests",
        ":network_tests",
        ":security_tests",
        ":transaction_tests",
    ],
)