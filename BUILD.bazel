# SQLCC根目录BUILD.bazel - 主应用和测试套件定义
# 遵循设计文档的包层次结构，引用子包目标

package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

# ==================== 主应用程序 ====================

# SQLCC服务器端程序 - 引用子包目标
cc_binary(
    name = "sqlcc",
    srcs = ["//src/sqlcc_server:server_main.cpp"],
    deps = [
        "//src/network:network",
        "//src/core:core",
        "//src/sql_executor:sql_executor",
        "//src/sql_parser:sqlcc_parser",
        "//src/storage_engine:storage_engine",
        "//src/logger:logger",
    ],
    includes = ["include"],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
        "-lssl",
        "-lcrypto",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
)

# ISQL客户端程序 - 引用子包目标
cc_binary(
    name = "isql",
    srcs = ["//src/isql_network:client_main.cpp"],
    deps = [
        "//src/isql_network:isql_network_lib",
        "//src/network:network",
        "//src/core:core",
        "//src/sql_executor:sql_executor",
        "//src/logger:logger",
    ],
    includes = ["include"],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
        "-lssl",
        "-lcrypto",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
)

# ==================== 调试工具 ====================

# 调试B+树程序
cc_binary(
    name = "debug_bplus_tree",
    srcs = ["debug_bplus_tree.cpp"],
    deps = [
        "//src/storage_engine:storage_engine",
        "//src/logger:logger",
    ],
    includes = ["include"],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
)

# ==================== C++20 Modules 测试 ====================

# C++20 Logger模块测试
cc_binary(
    name = "test_logger_module",
    srcs = [
        "test_logger_module.cpp",
    ],
    data = [
        "//include/utils:logger.cppm",
        "//src/utils:logger_module.cpp",
    ],
    copts = [
        "-std=c++20",
        "-fmodules-ts",  # GCC/Clang modules标志
    ],
    features = ["cpp20_modules"],
)
