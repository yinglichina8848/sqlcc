#!/bin/bash
# SQLCC 统一测试运行脚本

echo "=== SQLCC v1.1.1 集成测试框架 ==="
echo "运行所有测试类型: Unit, Coverage, Performance"
echo ""

# 设置测试输出目录
TEST_DIR="@TEST_OUTPUT_DIR@"
cd "@CMAKE_BINARY_DIR@"

# 运行单元测试
echo "1. 运行单元测试..."
if [ -f "${TEST_DIR}/unit/unit_tests" ]; then
    "${TEST_DIR}/unit/unit_tests"
    echo "单元测试完成"
else
    echo "单元测试可执行文件未找到"
fi

echo ""

# 运行覆盖率测试  
echo "2. 运行覆盖率测试..."
if [ -f "${TEST_DIR}/coverage/coverage_tests" ]; then
    "${TEST_DIR}/coverage/coverage_tests"
    echo "覆盖率测试完成"
else
    echo "覆盖率测试可执行文件未找到"
fi

echo ""

# 运行性能测试
echo "3. 运行性能测试..."
if [ -f "${TEST_DIR}/performance/performance_tests" ]; then
    "${TEST_DIR}/performance/performance_tests"
    echo "性能测试完成"
else
    echo "性能测试可执行文件未找到"
fi

echo ""
echo "=== 所有测试运行完成 ==="
