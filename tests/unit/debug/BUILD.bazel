cc_binary(
    name = "debug_privileges_test",
    srcs = ["debug_privileges_test.cpp"],
    deps = [
        "//src/sql_parser:sql_parser",
        "//src/core:core",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    features = ["cpp20_modules"],
)

