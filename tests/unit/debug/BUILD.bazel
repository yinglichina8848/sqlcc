# Bazel构建配置 for SQLCC debug测试
# 使用现代C++特性

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

cc_test(
    name = "debug_lexer_test",
    srcs = ["debug_lexer_test.cpp"],
    deps = [
        "//src/sql_parser:sql_parser",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
        # 添加覆盖率相关编译选项
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
        # 添加覆盖率相关链接选项
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    features = ["cpp20_modules"],
    # 添加覆盖率标签
    tags = ["coverage"],
)

