# 解析器单元测试套件
package(default_visibility = ["//visibility:public"])

cc_test(
    name = "sql_parser_high_coverage_test",
    srcs = ["sql_parser_high_coverage_test.cpp"],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Iinclude",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    deps = [
        "@com_google_googletest//:gtest_main",
        "//src/sql_parser:sql_parser",
    ],
)

test_suite(
    name = "parser_unit_tests",
    tests = [
        ":sql_parser_high_coverage_test",
        "//tests/components/parser:parser_component_tests",
    ],
)
