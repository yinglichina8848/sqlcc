# Bazel构建配置 for SQLCC 执行引擎模块测试
# 执行引擎组件单元测试

load("@rules_cc//cc:defs.bzl", "cc_test")

# Join执行器测试
cc_test(
    name = "join_executor_unit_test",
    srcs = ["join_executor_test.cpp"],
    deps = [
        "//src/execution:join_executor",
        "//src/core:core",
        "//src/sql_parser:sql_parser",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    features = ["cpp20_modules"],
)

