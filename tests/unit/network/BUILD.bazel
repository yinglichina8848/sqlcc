load("@rules_cc//cc:defs.bzl", "cc_test")

cc_test(
    name = "multi_threaded_network_manager_test",
    srcs = ["multi_threaded_network_manager_test.cpp"],
    deps = [
        "@com_google_googletest//:gtest_main",
        "//src/core:core",
        "//src/utils:utils",
        "//src/network:network",
        "//src/execution:execution",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    features = ["cpp20_modules"],
)

