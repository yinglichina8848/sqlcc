# Bazel构建配置 for SQLCC 测试 - C++20 + Clang-18
# 使用现代C++特性提升测试质量和覆盖率

load("@rules_cc//cc:defs.bzl", "cc_test")


cc_test(
    name = "b_plus_tree_test",
    srcs = ["b_plus_tree_test.cpp"],
    deps = [
        "@com_google_googletest//:gtest_main",
        "//src/core:core",
        "//src/utils:utils",
        "//src/storage_engine:storage_engine",
        "//src/sql_parser:sql_parser",
        "//src/execution:execution",
        "//src/config_manager:sqlcc_config_manager",
    ],
    # C++20 + Clang-18 配置
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    features = ["cpp20_modules"],
)

# B+树测试 - 覆盖率版本
