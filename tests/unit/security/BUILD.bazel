cc_test(
    name = "dcl_advanced_test",
    srcs = ["dcl_advanced_test.cpp"],
    deps = [
        "//include:config_manager",
        "//include:sql_executor",
        "//include:storage_engine",
        "//include:transaction_manager",
        "//include/core:user_manager",
        "//include/core:permission_validator",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-O2",
        "-Wall",
        "-Wextra",
        "-pthread",
    ],
    linkopts = [
        "-pthread",
        "-ldl",
    ],
    timeout = "long",
    tags = [
        "security",
        "dcl",
        "exclusive",  # Run exclusively to avoid resource conflicts
    ],
)

