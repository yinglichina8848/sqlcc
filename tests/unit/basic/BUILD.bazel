load("@rules_cc"//cc:defs.bzl"", "cc_test")


# 基础单元测试套件
package(default_visibility = ["//visibility:public"])

cc_test(
    name = "execution_context_test",
    srcs = ["execution_context_test.cpp"],
    includes = ["include"],
    deps = [
        "@com_google_googletest//:gtest_main",
        "//src/core:core",
        "//src/core:sqlcc_core_lib",
        "//src/sql_parser:sql_parser",
        "//src/execution:execution",
        "//src:execution_context",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
)

cc_test(
    name = "permission_validator_test",
    srcs = ["permission_validator_test.cpp"],
    deps = [
        "//src/core:sqlcc_database_core",
        "//src/core:sqlcc_core_lib",
        "//src/sql_parser:sql_parser",
        "//src/sql_executor:sqlcc_executor",
        "//src/storage_engine:storage_engine",
        "//src:unified_executor",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
)

