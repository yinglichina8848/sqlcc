load("@rules_cc//cc:defs.bzl", "cc_test")

cc_test(
    name = "stored_procedure_manager_test",
    srcs = ["stored_procedure_manager_test.cpp"],
    deps = [
        "@com_google_googletest//:gtest_main",
        "//src/core:core",
        "//src/core:database_manager",
        "//src/utils:utils",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    includes = ["../../../include"],
    features = ["cpp20_modules"],
)

