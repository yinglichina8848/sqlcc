# Level 3 Transaction Manager Tests - Unified Configuration
# These tests verify transaction management components with LLVM coverage support

load("//tests:build_config.bzl", "sqlcc_test")

# Configuration tests
sqlcc_test(
    name = "config_test",
    srcs = ["config/config_test.cpp"],
    deps = [
        "//src/core:core",
        "//src/exception:exception",
        "//src/transaction_manager:transaction_manager",
    ],
    copts = [
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    linkopts = [
        "-fprofile-instr-generate",
    ],
)

# Database manager tests
sqlcc_test(
