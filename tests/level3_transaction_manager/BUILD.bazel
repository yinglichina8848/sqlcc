# Level 3 Transaction Manager Tests
# This directory contains tests for transaction management, task execution, and system coordination

load("@rules_cc//cc:defs.bzl", "cc_test")

# Task Executor Tests
cc_test(
    name = "task_executor_tests",
    srcs = glob([
        "task_executor/*.cpp",
    ], allow_empty = True),
    copts = [
        "-std=c++20",
        "-Iinclude",
        "-Isrc",
    ],
    deps = [
        "//src/execution/task_executor.h",
        "//src/execution/task_result.h",
        "//src/execution/query_plan_factory.h",
        "//src/execution/unified_query_plan.h",
        "//src/execution/cost_estimator.h",
        "//src/execution/function_executor.h",
        "//src/execution/load_data_executor.h",
        "//src/execution/window_function_executor.h",
        "//src/execution/recursive_query_executor.h",
        "//src/execution/join_executor.h",
        "//src/execution/ddl_execution_strategy.h",
        "//src/execution/dml_execution_strategy.h",
        "//src/execution/execution_strategy.h",
        "//src/execution/comprehensive_task_executor.h",
        "//src/execution/task_executor_simple.h",
        "//src/execution/aggregate_engine.h",
        "//src/execution/group_by_executor.h",
        "//src/execution/unified_executor.h",
        "//src/execution/test_runner.h",
        "//src/execution/standalone_test.h",
        "//src/sql_executor/transaction_control_manager.h",
        "//src/sql_executor/domain_manager.h",
        "//src/sql_executor/procedure_executor.h",
        "//src/sql_executor/procedure_function_manager.h",
        "//src/sql_executor/enhanced_alter_table_manager.h",
        "//src/sql_executor/enhanced_trigger_manager.h",
        "//src/core/execution_context.h",
        "//src/core/execution_result.h",
        "//src/core/system_database.h",
        "//src/core/core_database_manager.h",
        "//src/core/user_manager.h",
        "//src/core/permission_validator.h",
        "//src/exception:exception",
        "//src/exception:io_exception",
        "//src/utils:logger",
        "@com_google_googletest//:gtest_main",
    ],
    tags = ["level3", "transaction_manager", "task_executor"],
)

