# Level 3 Transaction Manager Tests
# This directory contains tests for transaction management, task execution, and system coordination

load("@rules_cc//cc:defs.bzl", "cc_test")

# Task Executor Tests
cc_test(
    name = "task_executor_tests",
    srcs = glob([
        "task_executor/*.cpp",
    ], allow_empty = True),
    copts = [
        "-std=c++20",
        "-Iinclude",
        "-Isrc",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    linkopts = ["-fprofile-instr-generate"],
    deps = [
        "@com_google_googletest//:gtest_main",
        "//src/core:core",
        "//src/logger:logger",
        "//src/exception:exception",
        "//src/sql_executor:sql_executor",
    ],
    tags = ["coverage", "level3", "transaction_manager", "task_executor"],
)

