load("@rules_cc//cc:defs.bzl", "cc_test")

# Level 4 SQL Parser Tests
# This level contains all SQL parsing related tests, organized by functionality

# =============================================
# AST Sub-library Tests (sql_parser:ast)
# =============================================
cc_test(
    name = "ast_tests",
    srcs = glob([
        "ast/*.cpp",
    ], allow_empty = True),
    deps = [
        "//include:sqlcc_pch",
        "//src/sql_parser:headers",
        "//src/sql_parser:ast",  # 依赖拆分后的ast子库
        "//src/logger:logger",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-Iinclude",
    ],
    linkopts = [
        "-pthread",
    ],
)

