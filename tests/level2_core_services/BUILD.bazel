# Level 2 Core Services Tests - Core Database Services
# These tests verify core database services components (database management, user management, etc.)

load("@rules_cc//cc:defs.bzl", "cc_test")

# Database manager tests
cc_test(
    name = "database_manager_tests",
    srcs = ["database_manager/database_manager_test.cpp"],
    deps = [
        "//include/core:core_database_manager",
        "//include/core:system_database",
        "//include/utils:logger",
        "//src/core:core_database_manager",
        "//src/core:system_database",
        "//src/logger:logger",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-Wno-unused-but-set-variable",
    ],
    linkopts = ["-fprofile-instr-generate"],
    tags = ["coverage", "level2", "core_services", "database_manager"],
)

