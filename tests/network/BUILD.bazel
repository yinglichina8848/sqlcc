# SQLCC Network Tests
# This file contains all network-related test programs
# All tests use CLang compiler as specified

# Authentication test server
cc_binary(
    name = "auth_test_server",
    srcs = ["auth_test_server.cpp"],
    deps = [
        "//src/network:network",
        "//src/core:core",
        "//src/utils:utils",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
    ],
    linkopts = [
        "-pthread",
    ],
    visibility = ["//visibility:public"],
)

