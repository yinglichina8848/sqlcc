load("@rules_cc//cc:defs.bzl", "cc_test")

# 客户端服务器集成测试
cc_test(
    name = "client_server_integration_test",
    srcs = ["client_server_integration_test.cpp"],
    includes = ["../../include", "."],
    deps = [
        "//src/network:sqlcc_network",
        "//src/core:sqlcc_database_core",
        "@com_google_googletest//:gtest_main",
    ],
)

# 加密集成测试
cc_test(
    name = "encrypted_integration_test",
    srcs = ["encrypted_integration_test.cpp"],
    includes = ["../../include", "."],
    deps = [
        "//src/network:sqlcc_network",
        "@com_google_googletest//:gtest_main",
    ],
)

# 客户端测试
cc_test(
    name = "client_test",
    srcs = ["client_test.cpp"],
    includes = ["../../include", "."],
    deps = [
        "//src/network:sqlcc_network",
        "@com_google_googletest//:gtest_main",
    ],
)

# 加密测试运行器
cc_test(
    name = "encrypted_test_runner",
    srcs = ["encrypted_test_runner.cpp"],
    includes = ["../../include", "."],
    deps = [
        "//src/network:sqlcc_network",
        "@com_google_googletest//:gtest_main",
    ],
)

# 服务器管理器测试
cc_test(
    name = "server_manager_test",
    srcs = ["server_manager.cpp"],
    includes = ["../../include", "."],
    deps = [
        "//src/network:sqlcc_network",
        "//src/core:sqlcc_database_core",
        "@com_google_googletest//:gtest_main",
    ],
)

# 客户端服务器测试套件
test_suite(
    name = "client_server_test_suite",
    tests = [
        ":client_server_integration_test",
        ":client_test",
        ":encrypted_integration_test",
        ":encrypted_test_runner",
        ":server_manager_test",
    ],
)