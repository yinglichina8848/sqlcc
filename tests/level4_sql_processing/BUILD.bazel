load("@rules_cc//cc:defs.bzl", "cc_test")

# Level 4 SQL Processing Tests
# This level contains SQL processing and execution related tests, organized by functionality

# Execution context tests
cc_test(
    name = "execution_context_tests",
    srcs = glob([
        "execution_context/*.cpp",
    ], allow_empty = True),
    deps = [
        "//src:sqlcc_pch",
        "//src/core:execution_context",
        "//src/core:execution_context",
        "//src/logger:logger",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-Iinclude",
    ],
    linkopts = [
        "-pthread",
    ],
)

