# level2_storage_engine Tests - Unified Configuration
# These tests verify core storage engine components (B+ tree, disk manager, etc.)

load("//tests:build_config.bzl", "sqlcc_test")

# B+ tree tests
sqlcc_test(
    name = "b_plus_tree_test",
    srcs = ["b_plus_tree/b_plus_tree_test.cpp"],
    deps = [
        "//src/storage:b_plus_tree",
        "//src/exception:exception",
    ],
)

# Disk manager tests
sqlcc_test(
    name = "disk_manager_test",
    srcs = ["disk_manager/disk_manager_test.cpp"],
    deps = [
        "//src/disk_manager:disk_manager",
        "//src/exception:exception",
    ],
)