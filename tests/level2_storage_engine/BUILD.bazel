# Level 2 Storage Engine Tests Package
# This BUILD file defines all Level 2 storage engine tests

load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

# B+ Tree Tests
cc_test(
    name = "b_plus_tree_tests",
    srcs = glob(["b_plus_tree/*.cpp"], allow_empty = True),
    deps = [
        "//include/storage:b_plus_tree_headers",
        "//src/storage_engine:b_plus_tree_libs",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-Wno-unused-but-set-variable",
    ],
    linkopts = ["-fprofile-instr-generate"],
    tags = ["coverage", "level2", "storage_engine", "b_plus_tree"],
)

