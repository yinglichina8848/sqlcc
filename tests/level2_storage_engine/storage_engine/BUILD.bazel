cc_test(
    name = "storage_engine_tests",
    srcs = glob(["*.cpp"]),
    deps = [
        # Storage Engine Core
        "//include/storage_engine:storage_engine_headers",  # StorageEngine
        "//src/storage_engine:storage_engine_libs",         # StorageEngine implementation

        # B+ Tree components
        "//include/storage:b_plus_tree_headers",           # BPlusTreeIndex, BPlusTreeNodes
        "//src/storage_engine:b_plus_tree_libs",           # B+ Tree implementation

        # Buffer Pool
        "//include/storage:buffer_pool_headers",           # BufferPoolSharded
        "//src/storage_engine:buffer_pool_libs",           # Buffer Pool implementation

        # Concurrency Control
        "//include/storage:concurrency_control_headers",   # AdvancedLockManager
        "//src/storage_engine:concurrency_control_libs",   # Concurrency implementation

        # Index Manager
        "//include/storage_engine:index_manager_headers",   # SmartIndexCache
        "//src/storage_engine:index_manager_libs",         # Index Manager implementation

        # Configuration and Utils
        "//include/utils:config_manager_headers",          # ConfigManager
        "//src/utils:config_manager_libs",                # ConfigManager implementation

        "//include/utils:logger_headers",                  # Logger
        "//src/utils:logger_libs",                         # Logger implementation

        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-fprofile-instr-generate",    # LLVM覆盖率编译
        "-fcoverage-mapping",          # 源码映射
        "-Wno-unused-variable",        # 忽略未使用变量警告
        "-Wno-unused-parameter",       # 忽略未使用参数警告
    ],
    linkopts = ["-fprofile-instr-generate"],  # LLVM覆盖率链接
    tags = ["coverage", "level2", "storage_engine", "comprehensive"],
)
