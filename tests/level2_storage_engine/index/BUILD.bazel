package(default_visibility = ["//visibility:public"])

cc_test(
    name = "index_fast",
    srcs = ["index_test.cpp"],
    deps = [
        "@com_google_googletest//:gtest_main",
        "//src/storage_engine/index_manager:index_manager",
    ],
)

cc_test(
    name = "index_tests",
    srcs = glob([
        "*.cpp",
        "**/*.cpp",
    ]),
    deps = [
        "//src/storage_engine",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    linkopts = ["-fprofile-instr-generate"],
    tags = ["coverage", "level2", "storage_engine"],
)

test_suite(
    name = "all",
    tests = [":index_fast"],
)
