load("@rules_cc//cc:defs.bzl", "cc_test")

# Level 6 Enterprise Tests
# This level contains all enterprise-level features and security tests, organized by functionality

# Audit trail tests
cc_test(
    name = "audit_trail_tests",
    srcs = glob([
        "audit_trail/*.cpp",
    ], allow_empty = True),
    deps = [
        "//include:sqlcc_pch",
        "//include/security:audit_trail",
        "//src/logger:logger",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-Iinclude",
    ],
    linkopts = [
        "-pthread",
    ],
)

# Compliance manager tests
cc_test(
    name = "compliance_manager_tests",
    srcs = glob([
        "compliance_manager/*.cpp",
    ], allow_empty = True),
    deps = [
        "//include:sqlcc_pch",
        "//src/logger:logger",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-Iinclude",
    ],
    linkopts = [
        "-pthread",
    ],
)

# Enterprise security tests
cc_test(
    name = "enterprise_security_tests",
    srcs = glob([
        "enterprise_security/*.cpp",
    ], allow_empty = True),
    deps = [
        "//include:sqlcc_pch",
        "//src/security:enterprise_security",
        "//src/logger:logger",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-Iinclude",
    ],
    linkopts = [
        "-pthread",
    ],
)

# Test suite combining all enterprise tests
test_suite(
    name = "enterprise_test_suite",
    tests = [
        ":audit_trail_tests",
        ":compliance_manager_tests",
        ":enterprise_security_tests",
    ],
)
