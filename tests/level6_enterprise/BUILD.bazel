load("@rules_cc//cc:defs.bzl", "cc_test")

# Level 6 Enterprise Tests
# These tests verify enterprise-level features and components

cc_test(
    name = "enterprise_security_test",
    srcs = ["enterprise_security/enterprise_security_test.cpp"],
    deps = [
        "//src/security:enterprise_security",
        "//src/exception:exception",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
