load("@rules_cc//cc:defs.bzl", "cc_test")

# SQL执行器基础测试
cc_test(
    name = "gtest_sql_executor_tests",
    srcs = ["gtest_sql_executor_tests.cpp"],
    includes = ["../include"],
    deps = [
        "@com_google_googletest//:gtest_main",
        "//src/sql_parser:sql_parser",
        "//src/sql_executor:sqlcc_executor",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
)

