# SQLCC测试套件BUILD.bazel - 集成Google Test框架
# 提供完整的单元测试、集成测试和性能测试支持

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test", "cc_binary")
load("@bazel_tools//tools/build_defs/pkg:pkg.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

# ==================== Google Test 集成 ====================

# Google Test库依赖
cc_library(
    name = "gtest",
    deps = [
        "@com_google_googletest//:gtest_main",
    ],
)

cc_library(
    name = "gtest_main",
    deps = [
        "@com_google_googletest//:gtest_main",
    ],
)

# ==================== 测试框架基础库 ====================

# 注意：测试框架文件不存在，已移除

# ==================== Mock库 ====================

cc_library(
    name = "mocks",
    deps = [
        "//src/mocks:storage_engine_mock",
        "//src/mocks:database_manager_mock",
        "//src/mocks:transaction_manager_mock",
        "//src/mocks:index_manager_mock",
    ],
)

# ==================== 层次化测试体系 ====================

# Level 1 Foundation - 基础工具类测试
test_suite(
    name = "level1_foundation_tests",
    tests = [
        "//tests/level1_foundation/basic:basic_test",
    ],
    tags = ["level1", "foundation", "basic"],
)

# Level 2 Storage Engine - 存储引擎基础测试
test_suite(
    name = "level2_storage_engine_tests",
    tests = [
        "//tests/level2_storage_engine:level2_storage_engine_all",
    ],
    tags = ["level2", "storage", "engine"],
)

# Level 3 Transaction Manager - 事务管理器测试
test_suite(
    name = "level3_transaction_manager_tests",
    tests = [
        "//tests/level3_transaction_manager:task_executor_tests",
        "//tests/level3_transaction_manager:query_executor_tests",
        "//tests/level3_transaction_manager:transaction_control_tests",
        "//tests/level3_transaction_manager:execution_boundary_tests",
        "//tests/level3_transaction_manager:database_manager_tests",
        "//tests/level3_transaction_manager:user_manager_tests",
        "//tests/level3_transaction_manager:system_database_tests",
        "//tests/level3_transaction_manager:config_tests",
    ],
    tags = ["level3", "transaction", "manager"],
)

# Level 4 SQL Parser - SQL解析器测试
test_suite(
    name = "level4_sql_parser_tests",
    tests = [
        "//tests/level4_sql_parser:sql_parser_test_suite",
    ],
    tags = ["level4", "sql", "parser"],
)

# Level 4 SQL Processing - SQL处理测试
test_suite(
    name = "level4_sql_processing_tests",
    tests = [
        "//tests/level4_sql_processing:sql_processing_test_suite",
    ],
    tags = ["level4", "sql", "processing"],
)

# Level 5 Network - 网络通信测试
test_suite(
    name = "level5_network_tests",
    tests = [
        "//tests/level5_network:network_test_suite",
    ],
    tags = ["level5", "network", "communication"],
)

# Level 6 Enterprise - 企业级功能测试
test_suite(
    name = "level6_enterprise_tests",
    tests = [
        "//tests/level6_enterprise:enterprise_test_suite",
    ],
    tags = ["level6", "enterprise", "security"],
)

# Level 7 Integration - 端到端集成测试
test_suite(
    name = "level7_integration_tests",
    tests = [
        "//tests/level7_integration:integration_test_suite",
    ],
    tags = ["level7", "integration", "end_to_end"],
)

# 层次化测试总入口
test_suite(
    name = "hierarchical_tests",
    tests = [
        ":level1_foundation_tests",
        ":level2_storage_engine_tests",
        ":level3_transaction_manager_tests",
        ":level4_sql_parser_tests",
        ":level4_sql_processing_tests",
        ":level5_network_tests",
        ":level6_enterprise_tests",
        ":level7_integration_tests",
    ],
    tags = ["hierarchical", "comprehensive"],
)

# ==================== 单元测试 ====================

# 注意：单元测试已在相应子包中定义
# 存储引擎单元测试请参考 //tests/storage_engine:all
# 事务管理器单元测试请参考 //tests/transaction:all

# ==================== 集成测试 ====================

# 注意：集成测试已在子包 tests/integration 中定义
# 数据库管理器和SQL执行器集成测试请参考 //tests/integration:all

# ==================== 性能测试 ====================

# 注意：性能测试已在子包 tests/performance 中定义
# 存储引擎和索引性能测试请参考 //tests/performance:all

# ==================== 测试运行工具 ====================

# 注意：测试运行工具已在子包 tests/scripts 中定义
# 运行脚本请参考 //tests/scripts:all

# ==================== 覆盖率分析 ====================

# 注意：覆盖率分析工具已在子包 tests/scripts 中定义

# ==================== 测试数据 ====================

# 测试数据包
pkg_tar(
    name = "test_data",
    srcs = glob([
        "sql/**/*.sql",
    ], allow_empty = True),
)

