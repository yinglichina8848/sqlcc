# SQLCC测试套件BUILD.bazel - 集成Google Test框架
# 提供完整的单元测试、集成测试和性能测试支持

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test", "cc_binary")
load("@bazel_tools//tools/build_defs/pkg:pkg.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

# ==================== Google Test 集成 ====================

# Google Test库依赖
cc_library(
    name = "gtest",
    deps = [
        "@com_google_googletest//:gtest_main",
    ],
)

cc_library(
    name = "gtest_main",
    deps = [
        "@com_google_googletest//:gtest_main",
    ],
)

# ==================== 测试框架基础库 ====================

# 测试辅助工具库
cc_library(
    name = "test_framework",
    srcs = [
        "framework/test_base.cpp",
        "framework/test_helpers.cpp",
        "framework/performance_timer.cpp",
    ],
    hdrs = [
        "framework/test_base.h",
        "framework/test_helpers.h",
        "framework/performance_timer.h",
    ],
    deps = [
        ":gtest",
        "//include:sql_executor",
        "//include:storage_engine",
        "//include:transaction_manager",
        "//include:core_database_manager",
        "//src/mocks:storage_engine_mock",
        "//src/mocks:database_manager_mock",
        "//src/mocks:transaction_manager_mock",
        "//src/mocks:index_manager_mock",
    ],
    includes = ["../include"],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
)

# ==================== Mock库 ====================

cc_library(
    name = "mocks",
    deps = [
        "//src/mocks:storage_engine_mock",
        "//src/mocks:database_manager_mock",
        "//src/mocks:transaction_manager_mock",
        "//src/mocks:index_manager_mock",
    ],
)

# ==================== 单元测试 ====================

# 注意：单元测试已在相应子包中定义
# 存储引擎单元测试请参考 //tests/storage_engine:all
# 事务管理器单元测试请参考 //tests/transaction:all

# ==================== 集成测试 ====================

# 注意：集成测试已在子包 tests/integration 中定义
# 数据库管理器和SQL执行器集成测试请参考 //tests/integration:all

# ==================== 性能测试 ====================

# 注意：性能测试已在子包 tests/performance 中定义
# 存储引擎和索引性能测试请参考 //tests/performance:all

# ==================== 测试运行工具 ====================

# 注意：测试运行工具已在子包 tests/scripts 中定义
# 运行脚本请参考 //tests/scripts:all

# ==================== 覆盖率分析 ====================

# 注意：覆盖率分析工具已在子包 tests/scripts 中定义

# ==================== 测试数据 ====================

# 测试数据包
pkg_tar(
    name = "test_data",
    srcs = glob([
        "sql/**/*.sql",
    ], allow_empty = True),
)