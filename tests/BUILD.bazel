# tests/BUILD.bazel - 根目录测试定义
# 遵循设计文档的测试结构，使用标准cc_test

load("@rules_cc//cc:defs.bzl", "cc_test")

# ==================== SQL解析器测试 ====================

cc_test(
    name = "parser_create_table_test",
    srcs = ["parser_create_table_test.cpp"],
    deps = [
        "//src/sql_parser:sqlcc_parser",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
)

