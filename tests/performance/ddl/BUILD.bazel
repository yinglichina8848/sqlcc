cc_test(
    name = "ddl_performance_test",
    srcs = ["ddl_performance_test.cpp"],
    deps = [
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-O2",
        "-Wall",
        "-Wextra",
        "-pthread",
    ],
    linkopts = [
        "-pthread",
    ],
    timeout = "long",
    tags = [
        "performance",
        "ddl",
        "exclusive",  # Run exclusively to avoid resource conflicts
    ],
)

cc_binary(
    name = "ddl_concurrent_performance_test",
    srcs = ["ddl_concurrent_performance_test.cpp"],
    deps = [
        "//src/core:core",
        "//src/sql_executor:sql_executor",
        "//tests/performance:performance_test_base",
    ],
    copts = [
        "-std=c++20",
        "-O2",
        "-Wall",
        "-Wextra",
        "-pthread",
    ],
    linkopts = [
        "-pthread",
    ],
    tags = [
        "performance",
        "ddl",
        "concurrent",
        "exclusive",
    ],
)
