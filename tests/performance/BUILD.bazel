# Bazel构建配置 for SQLCC性能测试""

# 性能测试基类
cc_library(
    name = "performance_test_base",
    srcs = ["basic/performance_test_base.cc"],
    hdrs = ["performance_test_base.h"],
    visibility = ["//visibility:public"],
)

# CRUD性能测试头文件
cc_library(
    name = "crud_performance_test_lib",
    hdrs = ["crud/crud_performance_test.h"],
    deps = [
        "//src/core:core",
        "//src/sql_executor:sql_executor",
        "//src:core",
    ],
    visibility = ["//visibility:public"],
)

# CRUD性能测试（带覆盖率）
cc_test(
    name = "real_crud_performance_test",
    srcs = ["crud/real_crud_performance_test.cpp", "crud/main.cpp"],
    deps = [
        "//src:core",
        "//src/sql_executor:sql_executor",
        "//src/storage_engine:storage_engine",
        ":performance_test_base",
        ":crud_performance_test_lib",
        "@com_google_googletest//:gtest_main",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
    ],
)

# CRUD性能测试专用覆盖率版本
cc_test(
    name = "crud_performance_test_with_coverage",
    srcs = ["crud/real_crud_performance_test.cpp", "crud/main.cpp"],
    deps = [
        "//src:core",
        "//src/sql_executor:sql_executor",
        "//src/storage_engine:storage_engine",
        ":performance_test_base",
        ":crud_performance_test_lib",
        "@com_google_googletest//:gtest_main",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
        "-fprofile-instr-generate",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    tags = ["coverage"],
)

test_suite(
    name = "performance_tests",
    tests = [
        ":real_crud_performance_test",
    ],
)
