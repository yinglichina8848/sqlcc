"""Bazel构建配置 for SQLCC core组件测试"""

load("@rules_cc//cc:defs.bzl", "cc_test")

cc_test(
    name = "constraint_validation_test",
    srcs = ["constraint_validation_test.cpp"],
    includes = ["../../../include", "../../../include/core", "../../../include/storage", "../../../src/sql_executor"],
    deps = [
        "//src/core:sqlcc_core_lib",
        "//src/sql_executor:sqlcc_executor",
        "//src:execution_engine",
        "//src:unified_executor",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "simple_test",
    srcs = ["simple_test.cpp"],
    includes = ["../../../include", "../../../include/core"],
    deps = [
        "//src/sql_executor:sqlcc_executor",
        "//src:execution_engine",
        "//src:unified_executor",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "system_database_test",
    srcs = ["system_database_test.cpp"],
    includes = ["../../../include", "../../../include/core"],
    deps = [
        "//src/core:sqlcc_core_lib",
        "//src/sql_executor:sqlcc_executor",
        "//src/sql_parser:sqlcc_parser",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_test(
    name = "test_gtest",
    srcs = ["test_gtest.cpp"],
    includes = ["../../../include", "../../../include/core"],
    deps = [
        "//src/core:sqlcc_core_lib",
        "@com_google_googletest//:gtest_main",
    ],
)

test_suite(
    name = "core_component_tests",
    tests = [
        ":constraint_validation_test",
        ":simple_test",
        ":system_database_test",
        ":test_gtest",
    ],
)
