# SQLCC Security Tests
# Test programs for security components
# All tests use CLang compiler as specified

cc_binary(
    name = "memory_safety_framework",
    srcs = ["memory_safety_framework.cpp"],
    deps = [
        "//src/security:security",
        "//src/utils:utils",
        "//src/logger:logger",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
    ],
    linkopts = [
        "-pthread",
    ],
    visibility = ["//visibility:public"],
)