load("@rules_cc//cc:defs.bzl", "cc_test")

# Level 6 Integration Tests
# These tests verify system integration and end-to-end functionality

cc_test(
    name = "system_integration_test",
    srcs = ["system_integration/system_integration_test.cpp"],
    deps = [
        "//src/core:database_manager",
        "//src/storage_engine:storage_engine",
        "//src/transaction_manager:transaction_manager",
        "//src/sql_executor:sql_executor",
        "//src/network:network_manager",
        "//src/exception:exception",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    features = ["cpp20_modules"],
)

