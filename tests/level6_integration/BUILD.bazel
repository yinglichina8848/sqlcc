# Level 6 Integration Tests - Unified Configuration
# These tests verify network communication and distributed query functionality (B!6)
# Also includes system integration tests for end-to-end DML verification (B!8)
# Tests are defined in subpackages for better organization.

test_suite(
    name = "level6_integration_tests",
    tests = [
        "//tests/level6_integration/system_integration:system_integration_test",
        "//tests/level6_integration/performance_integration:performance_integration_test",
        "//tests/level6_integration/end_to_end:end_to_end_test",
        "//tests/level6_integration/network_communication:network_communication_test",
        "//tests/level6_integration/distributed_query:distributed_query_test",
    ],
    tags = ["level6", "integration"],
)

package(default_visibility = ["//visibility:public"])
