# Level 2 Core Tests with Coverage Support
# This directory contains tests for core database components

load("@rules_cc//cc:defs.bzl", "cc_test")

# ExecutionResult Tests with Coverage Support
cc_test(
    name = "execution_result_test",
    srcs = ["basic_execution_result_test.cpp"],
    copts = [
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    linkopts = ["-fprofile-instr-generate"],
    deps = [
        "@com_google_googletest//:gtest_main",
        "//src/core:core",
        "//src/execution:execution",
        "//src/transaction:transaction",
    ],
)

