load("@rules_cc//cc:defs.bzl", "cc_test")

# Level 5 Network Tests
# This level contains all network communication related tests, organized by functionality

# Connection pool tests
cc_test(
    name = "connection_pool_tests",
    srcs = glob([
        "connection_pool/*.cpp",
    ], allow_empty = True),
    deps = [
        "//src:sqlcc_pch",
        "//src/logger:logger",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-Iinclude",
    ],
    linkopts = [
        "-pthread",
    ],
)

# Network manager tests
cc_test(
    name = "network_manager_tests",
    srcs = glob([
        "network_manager/*.cpp",
    ], allow_empty = True),
    deps = [
        "//src:sqlcc_pch",
        "//src/logger:logger",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-Iinclude",
    ],
    linkopts = [
        "-pthread",
    ],
)

# Protocol handler tests
cc_test(
    name = "protocol_handler_tests",
    srcs = glob([
        "protocol_handler/*.cpp",
    ], allow_empty = True),
    deps = [
        "//src:sqlcc_pch",
        "//src/logger:logger",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-Iinclude",
    ],
    linkopts = [
        "-pthread",
    ],
)

# MySQL protocol boundary tests
cc_test(
    name = "mysql_protocol_boundary_test",
    srcs = glob([
        "mysql_protocol/*.cpp",
    ], allow_empty = True),
    deps = [
        "//src/network:mysql_protocol",
        "//src/network:connection_state",
        "//src/utils:utils_lib",
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    linkopts = [
        "-fprofile-instr-generate",
    ],
    tags = ["coverage"],
)

# Test suite combining all network tests
test_suite(
    name = "network_test_suite",
    tests = [
        ":connection_pool_tests",
        ":network_manager_tests",
        ":protocol_handler_tests",
        ":mysql_protocol_boundary_test",
    ],
)
