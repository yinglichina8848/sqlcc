cc_test(
    name = "basic_tests",
    srcs = glob(["basic/basic_test.cpp"]),
    deps = [
        "@com_google_googletest//:gtest_main",
    ],
    copts = [
        "-std=c++20",
        "-Iinclude",
        "-Ithird_party",
    ],
    timeout = "short",
