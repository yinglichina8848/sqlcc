load("@rules_cc//cc:defs.bzl", "cc_test")

# Level 1 Foundation Tests - 基础层测试
# 测试覆盖 SQLCC 数据库系统的核心基础组件
# 包括：异常处理、类型系统、配置管理、日志系统等核心基础设施

# Test suite for all level1 foundation tests
# 注意：子包的测试目标需要通过 //tests/level1_foundation/subpackage:target 引用
test_suite(
    name = "level1_foundation_tests",
    tests = [
        "//tests/level1_foundation/exception:exception_test",
        "//tests/level1_foundation/types:types_test",
        "//tests/level1_foundation/logger:logger_test",
        "//tests/level1_foundation/config:config_test",
        "//tests/level1_foundation/basic:basic_test",
        "//tests/level1_foundation/utils:utils_test",
        "//tests/level1_foundation/utils:file_descriptor_version_test",
        "//tests/level1_foundation/utils:ssl_connection_pool_test",
        "//tests/level1_foundation/utils:smart_config_test",
    ],
    tags = ["level1", "foundation"],
)

# Alias for all level1 tests including utils sub-tests
test_suite(
    name = "level1_all_tests",
    tests = [
        ":level1_foundation_tests",
        "//tests/level1_foundation/utils:file_descriptor_version_test",
        "//tests/level1_foundation/utils:ssl_connection_pool_test",
        "//tests/level1_foundation/utils:smart_config_test",
    ],
    tags = ["level1", "all"],
)

# Coverage report generation target
# 运行此目标生成完整的 Level 1 覆盖率报告
# 用法: bazel run //tests/level1_foundation:coverage_report
sh_binary(
    name = "coverage_report",
    srcs = ["coverage_report.sh"],
    data = [
        "//tests/level1_foundation/exception:exception_test",
        "//tests/level1_foundation/types:types_test",
        "//tests/level1_foundation/logger:logger_test",
        "//tests/level1_foundation/config:config_test",
        "//tests/level1_foundation/basic:basic_test",
        "//tests/level1_foundation/utils:utils_test",
        "//tests/level1_foundation/utils:file_descriptor_version_test",
        "//tests/level1_foundation/utils:ssl_connection_pool_test",
        "//tests/level1_foundation/utils:smart_config_test",
    ],
    tags = ["coverage", "level1"],
)