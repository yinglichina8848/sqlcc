load("@rules_cc//cc:defs.bzl", "cc_test")

# Exception module tests - 异常模块测试
# 测试覆盖所有异常类的功能、继承关系和异常处理机制

cc_test(
    name = "exception_test",
    srcs = ["exception_test.cpp"],
    copts = [
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
        "-Isrc/exception/include",
    ],
    linkopts = ["-fprofile-instr-generate"],
    deps = [
        "@com_google_googletest//:gtest",
        "@com_google_googletest//:gtest_main",
        "//src/exception:exception_coverage",  # 使用包含源码的覆盖率库
    ],
    tags = ["coverage", "level1"],
)