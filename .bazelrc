# SQLCC Bazel配置文件
# 遵循构建原则：预防为主 + 快速定位 + 工具赋能

# ==============================================================================
# 第一层：预防体系 - 降低错误发生率80%+
# ==============================================================================

# 构建前检查配置 - 禁止危险操作
build --incompatible_disallow_empty_glob
build --incompatible_enable_cc_toolchain_resolution

# 通用构建选项 - Clang 20 + C++20 + libc++
build --cxxopt=-std=c++20
build --cxxopt=-stdlib=libc++
build --linkopt=-stdlib=libc++
build --linkopt=-lc++abi
build --action_env=CC=clang-20
build --action_env=CXX=clang++-20
build --copt=-Wall
build --copt=-Wextra
build --copt=-Wno-error=uninitialized
build --copt=-O2

# 构建事件和输出配置
build --show_timestamps
build --verbose_failures
build --build_event_json_file=/tmp/bazel-build-events.json

# 并行构建配置 - 降低并行度避免超时
build --jobs=1

# 内存配置 - 优化内存资源使用，避免内存压力
build --local_ram_resources=4096

# 构建性能优化
build --spawn_strategy=standalone

# 平台配置
build --host_platform=@local_config_platform//:host
build --platforms=@local_config_platform//:host

# 工具链配置
build --incompatible_enable_cc_toolchain_resolution

# 特定于SQLCC的配置
build --define=sqlcc_version=1.2.12
build --define=sqlcc_build_type=bazel

# 测试配置 - 合理的超时时间
test --test_timeout=120
test --test_tag_filters=-manual,-slow

# 输出配置
build --show_timestamps
build --verbose_failures

# 覆盖率配置 - 使用LLVM coverage (Clang 20原生支持)
coverage --instrumentation_filter="//src/.*"
coverage --instrumentation_filter="//include/.*"
coverage --combined_report=lcov
coverage --experimental_use_llvm_covmap=true
coverage --experimental_generate_llvm_lcov=true

# LLVM coverage 配置
build:coverage --copt=-fprofile-instr-generate
build:coverage --copt=-fcoverage-mapping
build:coverage --linkopt=-fprofile-instr-generate

# 测试配置
test --test_output=all
test --test_timeout=300
test --test_strategy=exclusive
