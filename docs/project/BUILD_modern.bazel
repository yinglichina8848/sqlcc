# 性能基准测试 - 验证现代化改进效果
cc_test(
    name = "modern_performance_benchmark",
    srcs = [
        "test_modern_performance.cpp",  # 需要创建
    ],
    deps = [
        ":modern_logger",
        ":modern_user_manager",
        ":modern_storage_engine",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-O2",  # 性能测试使用O2优化
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_PERFORMANCE_TEST=1",
    ],
    tags = ["performance", "benchmark"],
)

# 实验性Modules测试 (仅当Clang支持时可用)
cc_test(
    name = "experimental_modules_test",
    srcs = [
        "test_experimental_modules.cpp",  # 需要创建
    ],
    deps = [
        ":modern_logger",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-fmodules",  # 实验性
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODULES=1",
        "SQLCC_MODERN_CPP=1",
    ],
    tags = ["experimental", "modules"],
)

# 构建配置测试 - 确保所有配置都能正常工作
test_suite(
    name = "modern_build_tests",
    tests = [
        ":dual_mode_logger_test",
        ":user_manager_migration_test",
        ":modern_cpp_integration_test",
        # ":experimental_modules_test",  # 暂时禁用实验性测试
    ],
)

# 性能测试套件
test_suite(
    name = "modern_performance_tests",
    tests = [
        ":modern_performance_benchmark",
    ],
    tags = ["performance"],
)

# 构建目标别名 - 方便使用
alias(
    name = "modern",
    actual = ":modern_build_tests",
)

alias(
    name = "benchmarks",
    actual = ":modern_performance_tests",
)
