# SQLCC服务器端程序构建配置

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "server_main",
    srcs = ["server_main.cpp"],
    deps = [
        "//src/core:core",
        "//src/network:network",
        "//src/sql_parser:sql_parser",
        "//src/sql_executor:sql_executor",
    ],
    includes = ["../include"],
    linkopts = ["-lssl", "-lcrypto"],
)