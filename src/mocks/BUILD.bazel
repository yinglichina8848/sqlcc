    srcs = ["storage_engine_mock.cpp"],
    hdrs = ["//include/mocks:storage_engine_mock.h"],
    deps = [
        "//include:storage_engine",
    ],
)

cc_library(
    name = "database_manager_mock",
    srcs = ["database_manager_mock.cpp"],
    hdrs = ["//include/mocks:database_manager_mock.h"],
    deps = [
        "//include:core_database_manager",
    ],
)

cc_library(
    name = "transaction_manager_mock",
    srcs = ["transaction_manager_mock.cpp"],
    hdrs = ["//include/mocks:transaction_manager_mock.h"],
    deps = [
        "//include:transaction_manager",
    ],
)

cc_library(
    name = "index_manager_mock",
    srcs = ["index_manager_mock.cpp"],
    hdrs = ["//include/mocks:index_manager_mock.h"],
    deps = [
        "//include/mocks:index_manager_mock",
        "//include:storage_index_manager",
