# //src/execution/BUILD.bazel - Execution模块
# 遵循设计文档的包层次结构

load("@rules_cc//cc:defs.bzl", "cc_library")

# 导出源文件以供其他包使用
exports_files([
    "function_executor.cpp",
    "join_executor.cpp",
    "set_operation_executor.cpp",
    "window_function_executor.cpp",
    "recursive_query_executor.cpp",
    "load_data_executor.cpp",
])

cc_library(
    name = "function_executor",
    srcs = ["function_executor.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:core",
        "//src/sql_parser:sql_parser",
        "//src/procedure:procedure",
        "//include/execution:function_executor",
        "//include/execution:task_executor",
        "//include/procedure:procedure_headers",
        "//include/sql_parser:function_ast",
    ],
)

cc_library(
    name = "join_executor",
    srcs = ["join_executor.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/core:core"
    ],
)

cc_library(
    name = "set_operation_executor",
    srcs = ["set_operation_executor.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        "//include/execution:set_operation_executor_hdr",
        "//src/sql_parser:set_operation",
        "//src/core:core",
    ],
)

cc_library(
    name = "window_function_executor",
    srcs = ["window_function_executor.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        "//include/execution:window_function_executor_hdr",
        "//src/sql_parser:window_function",
        "//src/core:core",
    ],
)

cc_library(
    name = "recursive_query_executor",
    srcs = ["recursive_query_executor.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        "//include/execution:recursive_query_executor_hdr",
        "//src/sql_parser:recursive_query",
        "//src/core:core",
    ],
)

cc_library(
    name = "load_data_executor",
    srcs = ["load_data_executor.cpp"],
    visibility = ["//visibility:public"],
    deps = [
        "//include/execution:load_data_executor_hdr",
        "//src/core:core",
    ],
)

# Subquery Executor
cc_library(
    name = "subquery_executor",
    srcs = ["subquery_executor.cpp"],
    hdrs = ["subquery_executor.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//include/execution:subquery_executor_hdr",
        "//include/execution_ast",
        "//src/core:core",
    ],
)

# 执行模块聚合库
cc_library(
    name = "execution",
    visibility = ["//visibility:public"],
    deps = [
        ":function_executor",
        ":join_executor",
        ":set_operation_executor",
        ":subquery_executor",
        ":window_function_executor",
        ":recursive_query_executor",
        ":load_data_executor",
    ],
)
