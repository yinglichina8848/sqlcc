package(default_visibility = ["//visibility:public"])

# -----------------------------------------------------------------------------
# 源文件库 - execution 模块的核心实现
# -----------------------------------------------------------------------------

cc_library(
    name = "execution",
    srcs = glob(["*.cpp"]),
    hdrs = glob(["*.h"]),
    strip_include_prefix = "",
    include_prefix = "",
    includes = [".", ".."],
    deps = [
        "//src/utils:utils",
        "//src/storage_engine:storage_engine",
        "//src/sql_parser:sql_parser",
        "//src/execution_ast:execution_ast",
        "//src/types:types",
        "//src/procedure:procedure",
        "//src/trigger:trigger",
        "//src/database_manager:database_manager",
        "//src/exception:exception",
        "//src/logger:logger",
        "//src:wal_manager",
        "//src:error_handler",
        "//src:sql_executor",
        "//src:permission_validator",
        "//src:view_manager",
        "//src/core:headers",
    ],
    visibility = ["//visibility:public"],
)

# -----------------------------------------------------------------------------
# 头文件库 - 向后兼容的头文件导出 (已迁移)
# -----------------------------------------------------------------------------

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

# -----------------------------------------------------------------------------
# 覆盖率专用库
# -----------------------------------------------------------------------------

cc_library(
    name = "execution_coverage",
    srcs = glob(["*.cpp"]),
    hdrs = glob(["*.h"]),
    strip_include_prefix = "",
    include_prefix = "",
    copts = [
        "-std=c++20",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
        "-I.",
    ],
    linkopts = ["-fprofile-instr-generate"],
    deps = [
        "//src/utils:utils_coverage",
        "//src/storage_engine:storage_engine_coverage",
        "//src/sql_parser:sql_parser_coverage",
        "//src/execution_ast:execution_ast",
        "//src/types:types_coverage",
        "//src/procedure:procedure",
        "//src/trigger:trigger",
        "//src/database_manager:database_manager",
        "//src/exception:exception_coverage",
        "//src/logger:logger_coverage",
        "//src:wal_manager",
        "//src:error_handler",
        "//src/core:headers",
    ],
    visibility = ["//visibility:public"],
    tags = ["coverage"],
)