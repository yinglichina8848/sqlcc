package(default_visibility = ["//visibility:public"])

# -----------------------------------------------------------------------------
# 源文件库 - execution 模块的核心实现
# -----------------------------------------------------------------------------

cc_library(
    name = "execution",
    srcs = glob(["*.cpp"]),
    hdrs = glob(["*.h"]),
    strip_include_prefix = "",
    include_prefix = "",
    deps = [
        "//src/core:core",
        "//src/sql_parser:sql_parser",
        "//src/utils:utils",
        "//src/exception:exception",
        "//src/logger:logger",
        # 注意：暂时移除对storage_engine的直接依赖，避免迁移冲突
        # "//src/storage_engine:storage_engine",
    ],
    visibility = ["//src:__subpackages__"],
)

# -----------------------------------------------------------------------------
# 头文件库 - 向后兼容的头文件导出 (已迁移)
# -----------------------------------------------------------------------------

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)
