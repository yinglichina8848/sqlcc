# AST 子模块 BUILD 文件
# 定义AST抽象语法树相关的库和测试

package(default_visibility = ["//visibility:public"])

# --------------------------
# AST 头文件库
# --------------------------
cc_library(
    name = "ast_headers",
    hdrs = [
        "ast_node.h",
        "expression.h",
        "statement.h",
        "ast_nodes.h",
        "ast_dcl_statements.h",
        "node_visitor.h",
        "debug_printer.h",
        "load_data_ast.h",
        "ast_fwd.h",
        "source_location.h",
        "binary_expression.h",
        "literal_expressions.h",
        "identifier_expression.h",
        "function_call_expression.h",
        "operator_kind.h",
        "set_operation.h",
        "dml/ast_dml_nodes.h",
        "ddl/ast_ddl_nodes.h",
        "utilities/ast_utility_nodes.h",
        "expressions/ast_expression_nodes.h",
    ],
    deps = [
        "//src/sql_parser:data_types",
        "//src/types:types",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# AST 实现库
# --------------------------
cc_library(
    name = "ast",
    srcs = [
        "ast_node.cpp",
        "expression.cpp",
        "source_location.cpp",
        "view_statements.cpp",
        "binary_expression.cpp",
        "set_operation.cpp",  # 移动至ast库
        "ast_dcl_statements.cpp",  # 添加DCL语句实现
        "ast_nodes.cpp",  # 添加表达式节点实现
        "ast_constraint.cpp",  # 添加约束实现
        "ddl/ast_ddl_nodes.cpp",  # 添加DDL语句实现
        "dml/ast_dml_nodes.cpp",
        "utilities/ast_utility_nodes.cpp",
        "expressions/ast_expression_nodes.cpp",
    ],
    hdrs = [
        "ast_node.h",
        "expression.h",
        "statement.h",
        "ast_nodes.h",
        "ast_dcl_statements.h",
        "node_visitor.h",
        "debug_printer.h",
        "load_data_ast.h",
        "ast_fwd.h",
        "source_location.h",
        "binary_expression.h",
        "set_operation.h",  # 移动至ast库
        "dml/ast_dml_nodes.h",
        "ddl/ast_ddl_nodes.h",
        "utilities/ast_utility_nodes.h",
        "expressions/ast_expression_nodes.h",
    ],
    strip_include_prefix = ".",  # 允许子目录使用相对路径包含父目录头文件
    deps = [
        ":ast_headers",
        "//src/storage_engine:storage_engine_headers",
        "//src/exception:exception",
        "//src/sql_parser:data_types",  # 依赖核心模块的共通AST
    ],
    visibility = ["//visibility:public"],
)

# ----------------------------
# BinaryExpression 独立测试
# ----------------------------
cc_test(
    name = "binary_expression_test",
    srcs = [
        "binary_expression_test.cpp",
        "binary_expression.cpp",
        "binary_expression.h",
    ],
    deps = [
        ":ast_headers",
        "//src/sql_parser:headers",
    ],
)