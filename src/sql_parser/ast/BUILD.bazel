# AST 子模块 BUILD 文件
# 定义AST抽象语法树相关的库和测试

package(default_visibility = ["//visibility:public"])

# --------------------------
# AST 头文件库
# --------------------------
cc_library(
    name = "ast_headers",
    hdrs = [
        "ast_node.h",
        "expression.h",
        "statement.h",
        "ast_nodes.h",
        "ast_dcl_statements.h",
        "node_visitor.h",
        "debug_printer.h",
        "load_data_ast.h",
        "ast_fwd.h",
        "source_location.h",
        "binary_expression.h",
        "literal_expressions.h",
        "identifier_expression.h",
        "function_call_expression.h",
        "operator_kind.h",
        "dml/ast_dml_nodes.h",
        "ddl/ast_ddl_nodes.h",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# AST 实现库
# --------------------------
cc_library(
    name = "ast",
    srcs = [
        "ast_node.cpp",
        "expression.cpp",
        "source_location.cpp",
        "view_statements.cpp",
        "binary_expression.cpp",
        "dml/ast_dml_nodes.cpp",
    ],
    hdrs = [
        "ast_node.h",
        "expression.h",
        "statement.h",
        "ast_nodes.h",
        "ast_dcl_statements.h",
        "node_visitor.h",
        "debug_printer.h",
        "load_data_ast.h",
        "ast_fwd.h",
        "source_location.h",
        "binary_expression.h",
        "dml/ast_dml_nodes.h",
        "ddl/ast_ddl_nodes.h",
    ],
    deps = [
        ":ast_headers",
        "//include/storage_engine:headers",
        "//src/exception:exception",
        "//src/sql_parser:common_ast",  # 依赖核心模块的共通AST
    ],
    visibility = ["//visibility:public"],
)

# ----------------------------
# BinaryExpression 独立测试
# ----------------------------
cc_test(
    name = "binary_expression_test",
    srcs = [
        "binary_expression_test.cpp",
        "binary_expression.cpp",
        "binary_expression.h",
    ],
    deps = [
        ":ast_headers",
        "//src/sql_parser:headers",
    ],
)