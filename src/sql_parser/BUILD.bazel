cc_library(
    name = "sqlcc_parser_light",
    srcs = glob([
        "lexer_new.cpp",
        "parser_new.cpp",
        "token_new.cpp",
        "set_operation_node.cpp",
    ], allow_empty = True),
    hdrs = glob([
        "lexer_new.h",
        "parser_new.h",
        "token_new.h",
    ], allow_empty = True),
    includes = [
        "../../include",
        "../../src/sql_parser",
    ],
    deps = [
        # light parser variant has no direct core dependency
        "//include/sql_parser:ast_node",
        "//include/sql_parser:ast_nodes",
        "//include/sql_parser:node_visitor",
    ],
    visibility = ["//visibility:public"],
)
