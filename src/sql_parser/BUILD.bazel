# src/sql_parser/BUILD.bazel
# SQL解析器模块 Bazel 构建配置
# 注意：include/sql_parser/BUILD.bazel 已废弃，全部迁移到此文件

package(default_visibility = ["//visibility:public"])

# -----------------------------------------------------------------------------
# SQL解析器头文件库
# -----------------------------------------------------------------------------
cc_library(
    name = "headers",
    hdrs = glob(["*.h", "**/*.h"], allow_empty=True),
    strip_include_prefix = "src/sql_parser",
    include_prefix = "sql_parser",
    visibility = ["//visibility:public"],
)

# -----------------------------------------------------------------------------
# 核心 SQL 解析器库
# -----------------------------------------------------------------------------
cc_library(
    name = "sql_parser_core",
    srcs = glob([
        "*.cpp",
        "ast/*.cpp",
    ], exclude=[
        "function_definition.cpp",       # 单独模块
        "advanced_sql92_features.cpp",   # 暂时缺少 Statement::Type 枚举
        "ast_dcl_statements.cpp",        # 存在编译错误
        "window_function.cpp",           # 单独模块
        "recursive_query.cpp",           # 单独模块
        "function_ast.cpp",              # 单独模块
        "set_operation.cpp",             # 单独模块
    ]),
    hdrs = [":headers"],
    includes = [
        "../../include",
        "../../src/types",
    ],
    deps = [
        "//src/sql_parser:headers",
        "//src/types:types",
        "//include/storage:storage_headers_lib",
    ],
    visibility = ["//visibility:public"],
)

# -----------------------------------------------------------------------------
# Function AST 模块
# -----------------------------------------------------------------------------
cc_library(
    name = "function_ast",
    srcs = ["function_ast.cpp"],
    hdrs = [":headers"],
    includes = [
        "../../include",
        "../../src/sql_parser",
    ],
    deps = [
        "//src/sql_parser:headers",
        ":function_definition_impl",
    ],
    visibility = ["//visibility:public"],
)

# Function Definition 实现
cc_library(
    name = "function_definition_impl",
