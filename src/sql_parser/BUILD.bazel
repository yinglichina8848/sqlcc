# SQL解析器头文件库定义

package(default_visibility = ["//visibility:public"])

# --------------------------
# AST 库 - 引用子模块
# --------------------------
cc_library(
    name = "ast",
    deps = [
        "//src/sql_parser/ast:ast",  # 引用子模块的ast库
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# Lexer 库
# --------------------------
cc_library(
    name = "lexer",
    srcs = [
        "lexer.cpp",
        "token.cpp",
    ],
    hdrs = [
        "token.h",
        "lexer_new.h",
    ],
    deps = [
        ":ast",
        "//src/exception:exception",
        "//src/utils:utils",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# Parser 库
# --------------------------
cc_library(
    name = "parser",
    srcs = [
        "parser.cpp",
        "set_operation.cpp",
        "recursive_query.cpp",
        "function_ast.cpp",
        "function_definition.cpp",
        "constraint.cpp",
        "data_types.cpp",
        "datetime.cpp",
        "decimal.cpp",
        "advanced_sql92_features.cpp",
    ],
    hdrs = [
        "parser.h",
        "set_operation.h",
        "recursive_query.h",
        "function_ast.h",
        "function/function_definition.h",
        "constraint.h",
        "data_types.h",
        "datetime.h",
        "decimal.h",
        "advanced_sql92_features.h",
    ],
    deps = [
        ":lexer",
        ":ast",
        ":json",
        "//src/exception:exception",
        "//src/utils:utils",
        "//include/trigger:headers",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# JSON 库
# --------------------------
cc_library(
    name = "json",
    srcs = [
        "json.cpp",
    ],
    hdrs = [
        "json.h",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# Window Function 库
# --------------------------
cc_library(
    name = "window",
    srcs = [
        "window_function.cpp",
    ],
    hdrs = [
        "window_function.h",
    ],
    deps = [
        ":parser",
        ":ast",
        "//src/exception:exception",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# 主要SQL解析器库
# --------------------------
cc_library(
    name = "sql_parser",
    srcs = glob(["*.cpp", "**/*.cpp"]),
    hdrs = glob(["*.h", "**/*.h"]) + ["ast_node.h", "ast_nodes.h"],
    deps = [
        "//src/exception:exception",
        "//src/utils:utils",
        "//include/storage:headers",
        ":headers",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# 向后兼容的综合头文件库
# --------------------------
cc_library(
    name = "headers",
    hdrs = glob(["*.h", "**/*.h"]),
    visibility = ["//visibility:public"],
)
