# SQL解析器组件Bazel构建配置

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "sqlcc_parser",
    srcs = glob([
        "*.cpp",
        "!window_function_node.cpp",
    ]),
    hdrs = glob([
        "*.h",
        "!lexer_new.h",
        "!parser_new.h",
        "!token_new.h",
    ]),
    copts = [
    ],
    includes = [
        "../../include",
    ],
    deps = [
        # parser does not depend on core to avoid dependency cycles
        "//include/sql_parser:sqlcc_parser_headers",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "sqlcc_parser_light",
    srcs = glob([
        "lexer_new.cpp",
        "parser_new.cpp",
        "token_new.cpp",
        "set_operation_node.cpp",
    ]),
    hdrs = glob([
        "lexer_new.h",
        "parser_new.h",
        "token_new.h",
    ]),
    copts = [
    ],
    includes = [
        "../../include",
    ],
    deps = [
        # light parser variant has no direct core dependency
        "//include/sql_parser:sqlcc_parser_headers",
    ],
    visibility = ["//visibility:public"],
)