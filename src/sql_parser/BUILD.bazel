load("@rules_cc//cc:defs.bzl", "cc_library")

# --------------------------
# AST 基础库
# --------------------------
cc_library(
    name = "ast",
    srcs = [
        "ast_node.cpp",
        "ast_nodes.cpp",
        "ast_dcl_statements.cpp",
        "ast/view_statements.cpp",
    ],
    hdrs = [
        "load_data_ast.h",
    ],
    includes = ["."],  # 允许 cpp 使用 #include "ast_node.h"
    visibility = ["//src/sql_parser:__subpackages__"],
    deps = [
        "//include/sql_parser:ast_headers",
    ],
)

# --------------------------
# Lexer 库
# --------------------------
cc_library(
    name = "lexer",
    srcs = [
        "lexer.cpp",
        "token.cpp",
    ],
    hdrs = [
        "//include/sql_parser:lexer_headers",
    ],
    includes = ["."],
    deps = [
        "//include/sql_parser:ast_headers",
    ],
    visibility = ["//src/sql_parser:__subpackages__"],
)

# --------------------------
# Parser 核心库
# --------------------------
cc_library(
    name = "parser",
    srcs = [
        "parser.cpp",
        "parser_set_operations.cpp",
        "recursive_query.cpp",
        "set_operation.cpp",
        "function_ast.cpp",
        "function_definition.cpp",
        "advanced_sql92_features.cpp",
        "data_types.cpp",
        "datetime.cpp",
        "decimal.cpp",
        "constraint.cpp",
        "constraint_validators.cpp",
    ],
    hdrs = [
        "//include/sql_parser:parser_headers",
    ],
    includes = ["."],
    deps = [
        ":ast",
        ":lexer",
        "//src/exception",
    ],
    visibility = ["//src/sql_parser:__subpackages__"],
)

# --------------------------
# Window Function 库
# --------------------------
cc_library(
    name = "window",
    srcs = [
        "window_function.cpp",
    ],
    hdrs = [
        "//include/sql_parser:window_headers",
    ],
    includes = ["."],
    deps = [":ast"],
    visibility = ["//src/sql_parser:__subpackages__"],
)

# --------------------------
# JSON 处理库
# --------------------------
cc_library(
    name = "json",
    srcs = [
        "json.cpp",
        "json/json_value.cpp",
    ],
    hdrs = [
        "//include/sql_parser:json_headers",
    ],
    includes = ["."],
    deps = [":ast"],
    visibility = ["//src/sql_parser:__subpackages__"],
)

# --------------------------
# 统一的sql_parser库（向后兼容）
# --------------------------
cc_library(
    name = "sql_parser",
    deps = [
        ":ast",
        ":lexer",
        ":parser",
        ":window",
        ":json",
    ],
    visibility = ["//src:__subpackages__"],
)
