# SQL解析器组件Bazel构建配置

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "sqlcc_parser",
    srcs = glob([
        "*.cpp",
    ]),
    hdrs = glob([
        "*.h",
    ]),
    copts = [
    ],
    includes = [
        "../../include",
    ],
    deps = [
        # parser does not depend on core to avoid dependency cycles
        "//include/sql_parser:ast_node",
        "//include/sql_parser:ast_nodes",
        "//include/sql_parser:node_visitor",
        "//include/storage:storage_headers_lib",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "function_ast",
    srcs = ["function_ast.cpp"],
    hdrs = ["function_ast.h"],
    deps = [
        "//include/sql_parser:function_ast",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "set_operation",
    srcs = ["set_operation.cpp"],
    includes = ["../../include"],
    deps = [
        "//include/sql_parser:set_operation",
        "//include/sql_parser:ast_nodes",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "window_function",
    srcs = ["window_function.cpp"],
    includes = ["../../include"],
    deps = [
        "//include/sql_parser:window_function",
        "//include/sql_parser:ast_node",
        "//include/sql_parser:node_visitor",
        "//include/sql_parser:token",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "recursive_query",
    srcs = ["recursive_query.cpp"],
    includes = ["../../include"],
    deps = [
        "//include/sql_parser:recursive_query",
        "//include/sql_parser:ast_node",
        "//include/sql_parser:ast_nodes",
        "//include/sql_parser:node_visitor",
        "//include/sql_parser:token",
        "//include/sql_parser:data_types",
        "//include/sql_parser:set_operation",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "load_data_ast",
    srcs = ["load_data_ast.h"],
    deps = [
        "//include/sql_parser:ast_node",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "sqlcc_parser_light",
    srcs = glob([
        "lexer_new.cpp",
        "parser_new.cpp",
        "token_new.cpp",
        "set_operation_node.cpp",
    ], allow_empty = True),
    hdrs = glob([
        "lexer_new.h",
        "parser_new.h",
        "token_new.h",
    ], allow_empty = True),
    copts = [
    ],
    includes = [
        "../../include",
    ],
    deps = [
        # light parser variant has no direct core dependency
        "//include/sql_parser:ast_node",
        "//include/sql_parser:ast_nodes",
        "//include/sql_parser:node_visitor",
    ],
    visibility = ["//visibility:public"],
)
