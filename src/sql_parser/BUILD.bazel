# SQL解析器头文件库定义

package(default_visibility = ["//visibility:public"])

# --------------------------
# AST 库 - 引用子模块
# --------------------------
cc_library(
    name = "ast",
    deps = [
        "//src/sql_parser/ast:ast_headers",  # 引用子模块的ast头文件库
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# Lexer 库
# --------------------------
cc_library(
    name = "lexer",
    srcs = [
        "lexer.cpp",
        "token.cpp",
    ],
    hdrs = [
        "token.h",
        "lexer.h",
    ],
    deps = [
        ":ast",
        "//src/exception:exception",
        "//src/utils:utils",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# Parser 库
# --------------------------
cc_library(
    name = "parser",
    srcs = [
        "parser.cpp",
        "set_operation.cpp",
        "recursive_query.cpp",
        "function_ast.cpp",
        "function_definition.cpp",
        "constraint.cpp",
        "data_types.cpp",
        "datetime.cpp",
        "decimal.cpp",
        "advanced_sql92_features.cpp",
    ],
    hdrs = [
        "parser.h",
        "set_operation.h",
        "recursive_query.h",
        "function_ast.h",
        "function/function_definition.h",
        "function/function_call.h",
        "function/function_ddl.h",
        "constraint.h",
        "data_types.h",
        "datetime.h",
        "decimal.h",
        "advanced_sql92_features.h",
        "window_function.h",
        "token.h",
    ],
    deps = [
        ":lexer",
        ":ast",
        ":json",
        "//src/exception:exception",
        "//src/utils:utils",
        "//include/trigger:headers",
        "//include/storage:table_storage",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# JSON 库
# --------------------------
cc_library(
    name = "json",
    srcs = [
        "json.cpp",
    ],
    hdrs = [
        "json.h",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# Window Function 库
# --------------------------
cc_library(
    name = "window",
    srcs = [
        "window_function.cpp",
    ],
    hdrs = [
        "window_function.h",
        "token.h",
    ],
    deps = [
        ":parser",
        ":ast",
        ":lexer",
        "//src/exception:exception",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# TokenStream 库
# --------------------------
cc_library(
    name = "token_stream",
    srcs = [
        "token_stream.cpp",
    ],
    hdrs = [
        "token_stream.h",
    ],
    deps = [
        ":lexer",
        ":ast",
        "//src/exception:exception",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# ExpressionParser 库
# --------------------------
cc_library(
    name = "expression_parser",
    srcs = [
        "expression_parser.cpp",
    ],
    hdrs = [
        "expression_parser.h",
    ],
    deps = [
        ":token_stream",
        ":ast",
        "//src/exception:exception",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# SelectParser 库
# --------------------------
cc_library(
    name = "select_parser",
    srcs = [
        "select_parser.cpp",
    ],
    hdrs = [
        "select_parser.h",
    ],
    deps = [
        ":token_stream",
        ":expression_parser",
        ":ast",
        "//src/exception:exception",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# StatementParser 库
# --------------------------
cc_library(
    name = "statement_parser",
    srcs = [
        "statement_parser.cpp",
    ],
    hdrs = [
        "statement_parser.h",
    ],
    deps = [
        ":token_stream",
        ":expression_parser",
        ":ast",
        "//src/exception:exception",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# 主要SQL解析器库
# --------------------------
cc_library(
    name = "sql_parser",
    srcs = glob(["*.cpp", "**/*.cpp"]),
    hdrs = glob(["*.h", "**/*.h"]),
    deps = [
        "//src/exception:exception",
        "//src/utils:utils",
        "//include/storage:headers",
        ":headers",
        ":ast",
        ":lexer",
        ":parser",
        ":json",
        ":window",
        ":token_stream",
        ":expression_parser",
        ":select_parser",
        ":statement_parser",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# 向后兼容的综合头文件库
# --------------------------
cc_library(
    name = "headers",
    hdrs = glob(["*.h", "**/*.h"]),
    visibility = ["//visibility:public"],
)
