# SQL解析器头文件库定义

package(default_visibility = ["//visibility:public"])

# --------------------------
# AST 库 - 引用子模块
# --------------------------
cc_library(
    name = "ast",
    deps = [
        "//src/sql_parser/ast:ast_headers",
        "//src/types:types",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# Lexer 库
# --------------------------
cc_library(
    name = "lexer",
    srcs = [
        "lexer.cpp",
        "token.cpp",
    ],
    hdrs = [
        "token.h",
        "lexer.h",
    ],
    deps = [
        ":ast",
        "//src/exception:exception",
        "//src/utils:utils",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# Parser 库 - 架构安全：禁止直接AST构造
# --------------------------
cc_library(
    name = "parser",
    srcs = [
        "parser.cpp",
        "recursive_query.cpp",
        "function_ast.cpp",
        "function_definition.cpp",
        "constraint.cpp",
        "data_types.cpp",
        "datetime.cpp",
        "decimal.cpp",
        "advanced_sql92_features.cpp",
        "architecture_safeguards.h",
        "parsers/parser_core.cpp",
        "parsers/ddl/parser_ddl.cpp",
        "parsers/dml/parser_dml.cpp",
        "parsers/dcl/parser_dcl.cpp",
        "parsers/tcl/parser_tcl.cpp",
        "parsers/helpers/parser_helpers.cpp",
    ],
    hdrs = [
        "parser.h",
        "set_operation.h",
        "recursive_query.h",
        "function_ast.h",
        "function/function_definition.h",
        "function/function_call.h",
        "function/function_ddl.h",
        "constraint.h",
        "data_types.h",
        "datetime.h",
        "decimal.h",
        "advanced_sql92_features.h",
        "window_function.h",
        "token.h",
        "architecture_safeguards.h",  # 🛡️ 架构防护措施
        "select_parser.h",
        "select_parser_fwd.h",
        "ddl_parser.h",
        "parsers/parser_core.h",
        "parsers/ddl/parser_ddl.h",
        "parsers/dml/parser_dml.h",
        "parsers/dcl/parser_dcl.h",
        "parsers/tcl/parser_tcl.h",
        "parsers/helpers/parser_helpers.h",
    ],
    deps = [
        ":lexer",
        ":ast",
        ":json",
        ":expression_parser",  # ✅ 明确依赖ExpressionParser
        ":select_parser",  # ✅ 添加对select_parser的依赖
        "//src/exception:exception",
        "//src/utils:utils",
         "//src/trigger:trigger_headers",
        "//src/storage_engine:table_storage_headers",
    ],
    # 🚨 构建时验证：确保不直接依赖AST构造类
    copts = [
        "-DARCHITECTURE_SAFEGUARDS_ENABLED",  # 启用架构防护
        "-Wno-unused-function",  # 忽略已删除方法的警告
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# Data Types 库 - 数据类型定义
# --------------------------
cc_library(
    name = "data_types",
    srcs = [
        "data_types.cpp",
    ],
    hdrs = [
        "data_types.h",
        "operator_kind.h",
    ],
    deps = [
        "//src/exception:exception",
        "//src/utils:utils",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# Function AST 库 - 函数相关AST定义
# --------------------------
cc_library(
    name = "function_ast_lib",
    srcs = [
        "function_ast.cpp",
    ],
    hdrs = [
        "function_ast.h",
    ],
    deps = [
        "//src/exception:exception",
        "//src/utils:utils",
        "//src/sql_parser/ast:ast_headers",  # 函数AST需要AST基础类
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# JSON 库
# --------------------------
cc_library(
    name = "json",
    srcs = [
        "json.cpp",
    ],
    hdrs = [
        "json.h",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# Window Function 库
# --------------------------
cc_library(
    name = "window",
    srcs = [
        "window_function.cpp",
    ],
    hdrs = [
        "window_function.h",
        "token.h",
    ],
    deps = [
        ":parser",
        ":ast",
        ":lexer",
        "//src/exception:exception",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# TokenStream 库
# --------------------------
cc_library(
    name = "token_stream",
    srcs = [
        "token_stream.cpp",
    ],
    hdrs = [
        "token_stream.h",
    ],
    deps = [
        ":lexer",
        ":ast",
        "//src/exception:exception",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# ExpressionParser 库
# --------------------------
cc_library(
    name = "expression_parser",
    srcs = [
        "expression_parser.cpp",
    ],
    hdrs = [
        "expression_parser.h",
        "operator_kind.h",
    ],
    deps = [
        ":token_stream",
        ":ast",
        "//src/exception:exception",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# SelectParser 库
# --------------------------
cc_library(
    name = "select_parser",
    srcs = [
        "select_parser.cpp",
    ],
    hdrs = [
        "select_parser.h",
    ],
     deps = [
         ":token_stream",
         ":expression_parser",
         ":ast",
         "//src/sql_parser/ast:ast_headers",  # 添加ast_headers for transitive dependencies
         ":lexer",  # 添加lexer依赖以获得token.h
         "//src/exception:exception",
     ],
    visibility = ["//visibility:public"],
)

# --------------------------
# StatementParser 库
# --------------------------
cc_library(
    name = "statement_parser",
    srcs = [
        "statement_parser.cpp",
    ],
    hdrs = [
        "statement_parser.h",
    ],
     deps = [
         ":token_stream",
         ":expression_parser",
         ":ast",
         "//src/sql_parser/ast:ast_headers",  # 添加ast_headers to ensure all ast headers are available
         ":parser",  # 添加对parser库的依赖，以获得data_types.h和set_operation.h
         "//src/exception:exception",
     ],
    visibility = ["//visibility:public"],
)

# --------------------------
# 主要SQL解析器库
# --------------------------
cc_library(
    name = "sql_parser",
    srcs = [
        "temp_ast_implementations.cpp",
        "parser.cpp",
        "recursive_query.cpp",
        "function_ast.cpp",
        "function_definition.cpp",
        "constraint.cpp",
        "data_types.cpp",
        "datetime.cpp",
        "decimal.cpp",
        "advanced_sql92_features.cpp",
        "parsers/parser_core.cpp",
        "parsers/ddl/parser_ddl.cpp",
        "parsers/dml/parser_dml.cpp",
        "parsers/dcl/parser_dcl.cpp",
        "parsers/tcl/parser_tcl.cpp",
        "parsers/helpers/parser_helpers.cpp",
    ],
    hdrs = glob(
        ["*.h", "parsers/*/*.h", "ast/*/*.h"],
        allow_empty = True
    ),
    deps = [
        "//src/exception:exception",
        "//src/utils:utils",
         "//src/storage_engine:storage_engine_headers",
        ":headers",
        ":ast",
        ":lexer",
        ":parser",
        ":json",
        ":window",
        ":token_stream",
        ":expression_parser",
        ":select_parser",
        ":statement_parser",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# 向后兼容的综合头文件库
# --------------------------
cc_library(
    name = "headers",
    hdrs = glob(["*.h", "**/*.h"]),
    visibility = ["//visibility:public"],
)