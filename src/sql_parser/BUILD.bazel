# SQL解析器组件Bazel构建配置

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "sql_parser",
    srcs = glob([
        "*.cpp",
        "ast/*.cpp",
    ], exclude = [
        "window_function.cpp",
        "recursive_query.cpp",
        "function_ast.cpp",
        "function_definition.cpp",  # 单独添加，避免glob重复包含
        "advanced_sql92_features.cpp",  # 暂时移除，缺少Statement::Type枚举
        "ast_dcl_statements.cpp",  # 暂时排除，存在编译错误
    ]),
    hdrs = glob([
        "*.h",
    ], allow_empty = True),
    includes = [
        "../../include",
        "../../src/types",
    ],
    deps = [
        "//src/types:types",
        "//include/sql_parser:headers",
        "//include/storage:storage_headers_lib",
        "//include/sql_parser:ast_node",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "function_ast",
    srcs = ["function_ast.cpp"],
    includes = [
        "../../include",
        "../../src/sql_parser",
    ],
    deps = [
        "//include/sql_parser:function_ast",
        "//include/sql_parser:ast_node",
        "//include/sql_parser:node_visitor",
        "//include/sql_parser:token",
        "//include/sql_parser:function_definition",
        ":function_definition_impl",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "set_operation",
    srcs = ["set_operation.cpp"],
    includes = [
        "../../include",
        "../../src/sql_parser",
        "../../src/storage_engine",
    ],
    deps = [
        "//include/sql_parser:set_operation",
        "//include/sql_parser:ast_node",
        "//include/sql_parser:ast_nodes",
        "//include/sql_parser:node_visitor",
        "//include/sql_parser:token",
        "//include/sql_parser:data_types",
        "//include/storage:table_storage",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "window_function",
    srcs = ["window_function.cpp"],
    hdrs = ["window_function.h"],
    includes = [
        "../../include",
        "../../src/sql_parser",
    ],
    deps = [
        "//include/sql_parser:window_function",
        "//include/sql_parser:ast_node",
        "//include/sql_parser:node_visitor",
        "//include/sql_parser:token",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "recursive_query",
    srcs = ["recursive_query.cpp"],
    includes = [
        "../../include",
        "../../src/sql_parser",
        "../../src/storage_engine",
    ],
    deps = [
        "//include/sql_parser:recursive_query",
        "//include/sql_parser:ast_node",
        "//include/sql_parser:ast_nodes",
        "//include/sql_parser:node_visitor",
        "//include/sql_parser:token",
        "//include/sql_parser:data_types",
        ":set_operation",
        "//include/storage:table_storage",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "load_data_ast",
    hdrs = ["load_data_ast.h"],
    includes = [
        "../../include",
        "../../src/sql_parser",
    ],
    deps = [
        "//include/sql_parser:ast_node",
    ],
    visibility = ["//visibility:public"],
