load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")


package(
    default_visibility = ["//visibility:public"],
    features = ["-parse_headers"],
)

cc_library(
    name = "transaction",
    srcs = [
        "savepoint_manager.cpp",
    ],
    hdrs = [
        "//include/transaction:savepoint_manager",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
    deps = [
        "//src/storage_engine:storage_engine",
        "//src/utils:utils",
        "//src/logger:logger",
    ],
)

cc_test(
    name = "transaction_test",
    size = "small",
    srcs = [
        "savepoint_manager_test.cpp",
        "transaction_test.cpp",
    ],
    includes = ["../include"],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
    deps = [
        ":transaction",
        "//include/utils:headers",
        "@gtest//:gtest",
    ],
)
