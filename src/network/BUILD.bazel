# 网络组件Bazel构建配置

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "sqlcc_network",
    srcs = glob(["*.cpp"]),
    hdrs = ["//include:network_headers"],
    includes = ["../../include"],
    deps = [
        "//src/sql_parser:sqlcc_parser",
        "//src/sql_executor:sqlcc_executor",
        "//src/core:sqlcc_core_lib",
    ],
    copts = ["-std=c++17"],
    linkopts = ["-lssl", "-lcrypto"],
)