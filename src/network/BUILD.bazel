    name = "session_manager",
    srcs = ["session_manager.cpp"],
    hdrs = ["//include/network:session_manager.h"],
    deps = [
        ":session",
        "//src/utils:utils",
        "//src/logger:logger",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "network",
    srcs = [
        "network.cpp",
        "connection_state_machine.cpp",
        "client_connection.cpp",
        "client_network_manager.cpp",
        "connection_handler.cpp",
        "mysql_protocol.cpp",
        "data_transmission_validator.cpp",
        "encryption.cpp",
        "network_exception_handler.cpp",
        "message_serializer.cpp",
        "server_network_manager.cpp",
    ],
    linkopts = [
        "-lssl",
        "-lcrypto",
    ],
    hdrs = [
        "//include/network:network.h",
        "//include/network:client_connection.h",
        "//include/network:client_network_manager.h",
        "//include/network:connection_handler.h",
        "//include/network:message_serializer.h",
        "//include/network:message_types.h",
        # "//include/network:server_network_manager.h",  # Temporarily disabled
        "//include/network:mysql_protocol.h",
        "//include/network:encryption.h",
    ],
    includes = ["//include"],
    copts = [
        "-Iinclude",
    ],
    deps = [
        ":session",
        ":session_manager",
        "//src/utils:utils",
        "//src/logger:logger",
        "//src/core:core",
        "//src/core:database_manager",
        "//src/sql_parser:sql_parser",
        "//src/storage_engine:storage_engine",
        "//src/sql_executor:sql_executor",
        "//include/network/encryption:encryption_headers",
        "//src/security:security",
        "//src/transaction:transaction",
    ],
    visibility = ["//visibility:public"],
)

