# 网络组件Bazel构建配置

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "sqlcc_network",
    srcs = [
        "encryption.cpp",
        "mysql_protocol.cpp",
        "network.cpp",
        "network_server.cpp",
    ],
    hdrs = ["//include:network_headers"],
    includes = ["../../include"],
    deps = [
        "//src/core:sqlcc_core_lib",
        "//include:utils_lib",
        "@com_google_absl//absl/strings",
    ],
    visibility = ["//visibility:public"],
    linkopts = ["-lssl", "-lcrypto"],
)
