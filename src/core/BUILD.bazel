# src/core/BUILD.bazel - SQLCC核心基础组件（严格规范化）

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "core",
    srcs = glob(["*.cpp"]),
    hdrs = glob(["*.h"]),
    deps = [
        # 严格按照依赖层级：core 只能依赖基础层级
        "//src/utils:utils",
        "//src/exception:exception",
        "//src/logger:logger",
        # 执行器需要解析SQL语句，因此必须依赖sql_parser
        "//src/sql_parser:sql_parser",
        # 不允许依赖任何业务模块（如 storage_engine 等）
    ],
    visibility = ["//src:__subpackages__"],
)
