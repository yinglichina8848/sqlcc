"""重构后的Bazel构建配置 - SQLCC核心组件库"""

package(default_visibility = ["//visibility:public"])

# ==============================================================================
# Core库 - 核心组件（简化版本）
# ==============================================================================
cc_library(
    name = "core",
    srcs = [
        "user_manager.cpp",
        "error_handler.cpp",
        "config_manager.cpp",
        "database_manager.cpp",
        "permission_validator.cpp",
        "sql_executor.cpp",
    ],
    hdrs = [
        "//include/core:user_manager.h",
        "//include/core:execution_context.h",
        "//include/core:unified_executor.h",
        "//include/core:permission_validator.h",
        "//include/core:schema_manager.h",
        "//include/core:system_database.h",
        "//include/core:execution_result.h",
        "//include/database_manager:database_manager",
        "//include/sql_executor:headers",
        "//include/error_handler:error_handler",
        "//include/exception:exception",
        # "//include/core:headers",  # 移除包含stored_procedure_manager的headers依赖
    ],
    includes = ["//include"],
    deps = [
        "//src/utils:utils",
        "//src/logger:logger",
        "//include:error_handler",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
    visibility = ["//visibility:public"],
)
