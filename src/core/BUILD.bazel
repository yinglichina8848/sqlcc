# src/core/BUILD.bazel - SQLCC核心基础组件（严格规范化）

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "core",
    srcs = glob(["*.cpp"]),
    hdrs = glob(["*.h"]),
    deps = [
        # 严格按照依赖层级：core 只能依赖基础层级
        "//src/utils:utils",
        "//src/exception:exception",
        "//src/logger:logger",
        # 执行器需要解析SQL语句，因此必须依赖sql_parser
        "//src/sql_parser:sql_parser",
        # database_file_manager 需要 table_storage 头文件
        "//src/storage_engine:table_storage",
        # sql_executor 需要的依赖
        "//src/sql_executor:headers",
        # unified_query_plan 和 view_manager 需要的依赖
        "//src:unified_query_plan",
        "//src:view_manager",
        # error_handler 需要的依赖
        "//src:all_headers",
        # 不允许依赖任何业务模块（如 storage_engine 等）
    ],
    visibility = ["//visibility:public"],
)

# 向后兼容的头文件库
cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)
