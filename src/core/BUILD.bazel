# //src/core/BUILD.bazel - SQLCC核心基础组件库
# 遵循设计文档的包层次结构

load("@rules_cc//cc:defs.bzl", "cc_library")


package(default_visibility = ["//visibility:public"])

# ==============================================================================
# Core库 - 核心基础组件（严格独立）
# ==============================================================================
cc_library(
    name = "core",
    srcs = [
        "user_manager.cpp",
        "error_handler.cpp",
        "permission_validator.cpp",
    ],
    hdrs = [
        "//include/core:user_manager.h",
        "//include/core:permission_validator.h",
    ],
    includes = ["//include"],
    deps = [
        # 只依赖基础工具库，不依赖任何业务模块
        "//src/logger:logger",
        "//src/utils:utils",
        "//include/exception:exception",
        "//include:error_handler",  # 错误处理模块
        "//include:sqlcc_pch",  # 预编译头文件
    ],
    copts = [
        "-Iinclude",
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
    visibility = ["//visibility:public"],
)

# ==============================================================================
# SQLCC Core Library - 核心组件聚合库（供测试使用）
# ==============================================================================
cc_library(
    name = "sqlcc_core_lib",
    deps = [
        ":core",
        "//src/storage_engine:storage_engine",
        "//src/sql_parser:sql_parser",
        "//src/execution:execution",
        "//src/logger:logger",
        "//src/utils:utils",
    ],
    visibility = ["//visibility:public"],
)

# ==============================================================================
# 独立的业务模块（不属于core）
# ==============================================================================

# Database Manager - 独立的数据库管理模块
cc_library(
    name = "database_manager",
    srcs = [
        "database_manager.cpp",
    ],
    hdrs = [
        "//include/core:database_manager.h",
    ],
    includes = ["//include"],
    deps = [
        ":core",  # 可以依赖core，但core不能依赖database_manager
        "//src/storage_engine:storage_engine",
        "//src/logger:logger",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
    visibility = ["//visibility:public"],
)

# SQL Executor Interface - 独立的SQL执行接口模块
cc_library(
    name = "sql_executor_interface",
    hdrs = [
        "//include/core:sql_executor_interface.h",
    ],
    includes = ["//include"],
    deps = [
        ":core",  # 可以依赖core，但core不能依赖sql_executor_interface
        "//src/logger:logger",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
    visibility = ["//visibility:public"],
)
