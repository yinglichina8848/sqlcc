# src/core/BUILD.bazel - SQLCC核心基础组件（严格规范化）

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "core",
    srcs = glob(["*.cpp"]),
    hdrs = glob(["*.h"]),
    deps = [
        "//src/utils:utils",
        "//src/storage_engine:storage_engine",
        "//src/storage_engine:table_storage",
        "//src/sql_parser:sql_parser",
        "//src/execution:execution",
        "//src/exception:exception",
        "//src/logger:logger",
        "//src:permission_validator",
        "//src:error_handler",
        "//src:view_manager",
    ],
    visibility = ["//visibility:public"],
)

# 向后兼容的头文件库
cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)
