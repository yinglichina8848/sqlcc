"""重构后的Bazel构建配置 - SQLCC统一核心组件库（最终解决方案）"""

package(default_visibility = ["//visibility:public"])

# ==============================================================================
# 最基础的错误处理组件
# ==============================================================================
cc_library(
    name = "error_handler",
    srcs = ["error_handler.cpp"],
    hdrs = ["//include:error_handler_header"],
    copts = [
    ],
    includes = ["../../include"],
    deps = [
    ],
    visibility = ["//visibility:public"],
)

# ==============================================================================
# 基础配置管理器组件
# ==============================================================================
cc_library(
    name = "sqlcc_config_manager",
    srcs = ["config_manager.cpp"],
    hdrs = ["//include:config_manager_headers"],
    copts = [
    ],
    includes = ["../../include"],
    deps = [
        ":error_handler",
    ],
    visibility = ["//visibility:public"],
)

# ==============================================================================
# 核心数据库组件（不依赖解析器）
# ==============================================================================
cc_library(
    name = "sqlcc_database_core",
    srcs = [
        "database_manager.cpp",
        "permission_validator.cpp",
    ],
    hdrs = [
        "//include:core_headers",
    ],
    copts = [
    ],
    includes = ["../../include"],
    deps = [
        ":sqlcc_config_manager",
        "//src/storage_engine:storage_engine",
    ],
    visibility = ["//visibility:public"],
)

# ==============================================================================
# 完整解析器组件
# ==============================================================================
cc_library(
    name = "sqlcc_parser",
    srcs = glob([
        "sql_parser/*.cpp",
    ]),
    hdrs = [
        "//include:sql_parser_headers",
    ],
    copts = [
    ],
    includes = [
        "../../include",
        "../../include/core",
        "../../include/sql_parser",
    ],
    deps = [
        ":error_handler",
    ],
    visibility = ["//visibility:public"],
)

# ==============================================================================
# 统一核心组件库 - 包含所有核心功能
# ==============================================================================
cc_library(
    name = "sqlcc_core_lib",
    srcs = [
        "user_manager.cpp",
        "sql_executor.cpp",
    ],
    hdrs = [
        "//include:core_headers",
        "//include:storage_engine_headers",
        "//include:sql_parser_headers",
        "//include:execution_headers",
    ],
    copts = [
    ],
    includes = [
        "../../include",
        "../../include/storage",
        "../../include/sql_parser",
        "../../include/core",
        "../../include/execution",
    ],
    deps = [
        # 基础组件
        ":sqlcc_database_core",
        "//src/sql_parser:sqlcc_parser",

        # 工具库
        "//include:utils_lib",
    ],
    visibility = ["//visibility:public"],
)