# 类型系统库

package(default_visibility = ["//visibility:public"])

# 类型管理器库（包含头文件和源文件）
cc_library(
    name = "types",
    hdrs = glob(["*.h"]),
    srcs = ["domain_manager.cpp"],
    copts = [
        "-std=c++20",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    linkopts = ["-fprofile-instr-generate"],
)

# 覆盖率专用库 - 包含源码用于覆盖率统计
cc_library(
    name = "types_coverage",
    hdrs = glob(["*.h"]),
    srcs = glob(["*.cpp"]),
    copts = [
        "-std=c++20",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    linkopts = ["-fprofile-instr-generate"],
    visibility = ["//visibility:public"],
    tags = ["coverage"],
)