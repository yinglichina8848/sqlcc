# src/sql_executor/BUILD.bazel - SQL执行器模块
# 遵循设计文档的包层次结构

load("@rules_cc"//cc:defs.bzl"", "cc_library")


# SQL Executor库 - SQL语句执行协调
cc_library(
    name = "sql_executor",
    srcs = ["sql_executor.cpp"],
    hdrs = ["//include/sql_executor:headers"],
    includes = ["//include"],
    deps = [
        "//src/core:core",
        "//src/utils:utils",
        "//src/storage_engine:storage_engine",
        "//src/sql_parser:sql_parser",
        # "//src/execution:execution",  # 暂时移除循环依赖
        "//src/logger:logger",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
    visibility = ["//visibility:public"],
)

