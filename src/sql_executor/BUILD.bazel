load("@rules_cc//cc:defs.bzl", "cc_library")

# SQL Executor库 - SQL语句执行协调
cc_library(
    name = "sql_executor",
    srcs = ["sql_executor.cpp", "view_manager.cpp"],
    deps = [
        "//include/sql_executor:sql_executor_headers",
