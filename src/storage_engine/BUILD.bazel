# --------------------------
# 主要存储引擎库
# --------------------------
cc_library(
    name = "storage_engine",
    srcs = glob(["**/*.cpp"]),
    hdrs = glob(["**/*.h"]),
    deps = [
        "//src/exception:exception",
        "//src/utils:utils",
        "//src/logger:logger",
    ],
    visibility = ["//visibility:public"],
)

# --------------------------
# 表存储组件库
# --------------------------
cc_library(
    name = "table_storage",
    srcs = glob(["table_storage/*.cpp"]),
    hdrs = glob(["table_storage/*.h"]) + [
        "//include/storage_engine/table_storage:record_validator.h",
        "//include/storage_engine/table_storage:page_raii.h",
    ],
    deps = [
        "//src/exception:exception",
        "//src/utils:utils",
        "//src/logger:logger",
        "//include/storage:headers",
    ],
    strip_include_prefix = "",
    include_prefix = "",
    visibility = ["//src:__subpackages__"],
)

# --------------------------
# 向后兼容的头文件库
# --------------------------
cc_library(
    name = "storage_engine_headers",
    hdrs = glob(["**/*.h"]),
    visibility = ["//visibility:public"],
)
