load("@rules_cc"//cc:defs.bzl"", "cc_library", "cc_test")


package(
    default_visibility = ["//visibility:public"],
    features = ["-parse_headers"],
)

cc_library(
    name = "storage_engine",
    srcs = [
        "storage_engine.cpp",
        "b_plus_tree.cpp",
        "table_storage_complete.cpp",
        "cache_consistency_manager.cpp",
        "data_integrity_validator.cpp",
