# --------------------------
# 主要存储引擎库
# --------------------------
cc_library(
    name = "storage_engine",
    srcs = glob(["**/*.cpp"]),
    hdrs = glob(["**/*.h"]),
    strip_include_prefix = "",
    deps = [
        "//src/utils:utils",
        "//src/storage_engine/buffer_pool:buffer_pool",
        "//src/exception:exception",
        "//src/logger:logger",
        "//src/page:page",
        "//src/storage:storage",
    ],
    copts = [
        "-std=c++20",
        "-g",
        "-Wall",
        "-Wextra",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    linkopts = ["-fprofile-instr-generate"],
    visibility = ["//visibility:public"],
)

# --------------------------
# 表存储组件库
# --------------------------
cc_library(
    name = "table_storage",
    srcs = glob(["table_storage/*.cpp"]),
    hdrs = glob(["table_storage/*.h"]),
    deps = [
        "//src/exception:exception",
        "//src/utils:utils",
        "//src/logger:logger",
        "//src/page:page",
        "//src/storage:storage",
        ":storage_engine",
    ],
    strip_include_prefix = "",
    include_prefix = "",
    visibility = ["//src:__subpackages__"],
)

# --------------------------
# 表存储头文件库
# --------------------------
cc_library(
    name = "table_storage_headers",
    hdrs = glob(["table_storage/*.h"]),
    visibility = ["//visibility:public"],
)

# --------------------------
# 向后兼容的头文件库
# --------------------------
cc_library(
    name = "storage_engine_headers",
    hdrs = glob(["**/*.h"]),
    visibility = ["//visibility:public"],
)
