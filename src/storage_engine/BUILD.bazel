cc_test(
    name = "storage_engine_test",
    size = "small",
    srcs = [
        "storage_engine_test.cpp",
        "b_plus_tree_test.cpp",
        "table_storage_test.cpp",
        "partition_manager_test.cpp",
    ],
    includes = ["."],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
    deps = [
        ":storage_engine",
        "//src/sql_parser:sql_parser",
        "//src/utils:utils",
        "@gtest//:gtest",
    ],
)

