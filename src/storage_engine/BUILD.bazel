# 存储引擎组件Bazel构建配置

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "sqlcc_storage_engine",
    srcs = [
        "advanced_lock_manager.cpp",
        "b_plus_tree.cpp",
        "buffer_pool.cpp",
        "cache_consistency_manager.cpp",
        "concurrent_access_validator.cpp",
        "concurrency_control.cpp",
        "data_integrity_validator.cpp",
        "disk_error_handler.cpp",
        "disk_manager.cpp",
        "lazy_writer.cpp",
        "page.cpp",
        "page_allocator.cpp",
        "performance_monitor.cpp",
        "record_boundary_validator.cpp",
        "storage_engine.cpp",
        "table_storage.cpp",
    ],
    hdrs = [
        "//include:storage_engine_headers",
    ],
    includes = ["../../include"],
    deps = [
        "//src/core:error_handler",
        "//src/core:sqlcc_config_manager",
    ],
    visibility = ["//visibility:public"],
    linkopts = ["-latomic"],
)

cc_library(
    name = "lazy_writer",
    srcs = ["lazy_writer.cpp"],
    hdrs = ["//include/storage:lazy_writer_hdr"],
    includes = ["../../include"],
    deps = [
        "//src/core:sqlcc_config_manager",
        "//src/storage_engine:sqlcc_storage_engine",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "sqlcc_index_manager",
