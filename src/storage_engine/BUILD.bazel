        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
    deps = [
        "//src/utils:utils",
        "//src/sql_parser:sql_parser",
        "//include/sql_parser:headers",
        "//include/utils:headers",
        "//include/storage_engine:storage_engine",
