        "//include:index_manager_headers",
    ],
    includes = ["../../include"],
    deps = [
        "//src/storage_engine:sqlcc_storage_engine",
        "//src/core:error_handler",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "sqlcc_concurrency_control",
    srcs = ["concurrency_control.cpp"],
    hdrs = [
        "//include/storage:concurrency_control_headers",
    ],
    includes = ["../../include"],
    deps = [
        "//src/core:error_handler",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "sqlcc_replace_strategy",
