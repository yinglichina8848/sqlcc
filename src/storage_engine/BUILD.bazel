load("@rules_cc//cc:defs.bzl", "cc_library")

# -----------------------------------------------------------------------------
# storage_engine 所有公共头文件
# -----------------------------------------------------------------------------
cc_library(
    name = "storage_engine_headers",
    hdrs = glob([
        "*.h",
        "buffer_pool/*.h",
        "index_manager/**/*.h",
        "table_storage/**/*.h",
        "b_plus_tree/**/*.h",
        "disk_manager/**/*.h",
        "wal/**/*.h",
    ], allow_empty = True),
    strip_include_prefix = "src/storage_engine",
    include_prefix = "storage_engine",
    visibility = ["//visibility:public"],
)

# -----------------------------------------------------------------------------
# 各模块实现库（示例：核心文件）
# -----------------------------------------------------------------------------
cc_library(
    name = "storage_engine_core",
    srcs = glob([
        "*.cpp",
        "b_plus_tree/**/*.cpp",
        "buffer_pool/*.cpp",
        "index_manager/**/*.cpp",
        "table_storage/**/*.cpp",
        "disk_manager/**/*.cpp",
        "wal/**/*.cpp",
    ], allow_empty = True),
    deps = [
        ":storage_engine_headers",
        "//src/utils:utils",
        "//src/exception:exception",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    visibility = ["//visibility:public"],
)

# -----------------------------------------------------------------------------
# storage_engine 主库（聚合库）
# -----------------------------------------------------------------------------
cc_library(
    name = "storage_engine",
    srcs = glob([
        "*.cpp",
        "b_plus_tree/**/*.cpp",
        "buffer_pool/*.cpp",
        "index_manager/**/*.cpp",
        "table_storage/**/*.cpp",
        "disk_manager/**/*.cpp",
        "wal/**/*.cpp",
        "cache_consistency_manager.cpp",
        "checkpoint.cpp",
        "concurrency_control.cpp",
        "concurrent_access_validator.cpp",
        "data_integrity_validator.cpp",
        "disk_error_handler.cpp",
        "lazy_writer.cpp",
        "node_size_manager.cpp",
        "page_allocator.cpp",
        "page.cpp",
        "partition_manager.cpp",
        "table_storage_complete.cpp",
        "wal_buffer.cpp",
        "wal_writer.cpp",
    ], allow_empty = True),
    deps = [
        "//include/storage:headers",
        "//src/utils:utils",
        "//src/exception:exception",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-error=maybe-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    visibility = ["//visibility:public"],
)
