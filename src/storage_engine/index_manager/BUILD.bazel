load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# 智能索引缓存库
cc_library(
    name = "smart_index_cache",
    srcs = ["smart_index_cache.cpp"],
    hdrs = ["smart_index_cache.h"],
    deps = [
        "//src/utils:utils",
        "//src/storage_engine:storage_engine_headers",
        "//src/transaction:transaction",
        "//src/exception:exception",
        "//src/storage_engine/b_plus_tree/index:bptree_index",
        "//src/storage_engine/b_plus_tree/node:bptree_node",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
)

# 智能索引工厂库
cc_library(
    name = "smart_index_factory",
    srcs = ["smart_index_factory.cpp"],
    hdrs = ["smart_index_factory.h", "enhanced_index_manager.h"],
    deps = [
        ":smart_index_cache",
        "//src/exception:exception",
        "//src/storage_engine/b_plus_tree/index:bptree_index",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
)

# 索引管理器库
cc_library(
    name = "index_manager",
    srcs = [
        "index_manager.cpp",
        "smart_ptr_lifetime_manager.cpp",
        "transactional_index_manager.cpp",
        "enhanced_index_manager.cpp",
    ],
    hdrs = [
        "index_manager.h",
        "smart_ptr_lifetime_manager.h",
        "transactional_index_manager.h",
        "enhanced_index_manager.h",
        "smart_index_cache.h",
        "smart_index_factory.h",
    ],
    deps = [
        ":smart_index_cache",
        ":smart_index_factory",
        "//src/exception:exception",
        "//src/utils:utils",
        "//src/storage_engine:storage_engine_headers",
        "//src/storage_engine/b_plus_tree:b_plus_tree",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
)
