# //src/utils/BUILD.bazel - Utils模块
# 遵循设计文档的包层次结构

load("@rules_cc//cc:defs.bzl", "cc_library")

# Headers filegroup - 头文件集合
filegroup(
    name = "headers",
    srcs = [
        "config_lifecycle.h",
        "config_manager.h",
        "config_snapshot.h",
        "connection_pool.h",
        "file_descriptor.h",
        "logger.h",
        "smart_config_manager.h",
        "ssl_wrapper.h",
        "thread_pool.h",
        "version.h",
    ],
    visibility = ["//visibility:public"],
)

# Thread Pool库 - 多线程任务执行器
cc_library(
    name = "thread_pool",
    srcs = ["thread_pool.cpp"],
    hdrs = ["thread_pool.h"],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-uninitialized",
        "-pthread",
    ],
    linkopts = [
        "-pthread",
    ],
    visibility = ["//visibility:public"],
)

# Logger库 - 日志系统
cc_library(
    name = "logger",
    srcs = ["logger.cpp"],
    hdrs = ["logger.h"],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    visibility = ["//visibility:public"],
)

# Utils库 - 工具库
cc_library(
    name = "utils",
    srcs = [
        "config_lifecycle.cpp",
        "config_manager.cpp",
        "config_snapshot.cpp",
        "smart_config_manager.cpp",
    ],
    hdrs = [
        "config_lifecycle.h",
        "config_manager.h",
        "config_snapshot.h",
        "smart_config_manager.h",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-uninitialized",
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    deps = [
        ":logger",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
    visibility = ["//visibility:public"],
)
