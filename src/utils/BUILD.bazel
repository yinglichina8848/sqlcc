package(default_visibility = ["//visibility:public"])

cc_library(
    name = "utils",
    srcs = glob(["*.cpp"]),
    hdrs = glob(["*.h"]),
    strip_include_prefix = "",
    include_prefix = "",
    deps = [
    ],
    visibility = ["//visibility:public"],
)

# 覆盖率专用库 - 包含所有源码用于覆盖率统计
cc_library(
    name = "utils_coverage",
    srcs = glob(["*.cpp"]),
    hdrs = glob(["*.h"]),
    copts = [
        "-fprofile-instr-generate",
        "-fcoverage-mapping",
    ],
    linkopts = ["-fprofile-instr-generate"],
    strip_include_prefix = "",
    include_prefix = "",
    visibility = ["//visibility:public"],
    tags = ["coverage"],
)
