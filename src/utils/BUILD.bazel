# src/utils/BUILD.bazel - Utils模块
# 遵循设计文档的包层次结构

load("@rules_cc"//cc:defs.bzl", "cc_library")


# Utils库 - 工具库
cc_library(
    name = "utils",
    srcs = [
        "config_lifecycle.cpp",
        "config_manager.cpp",
        "config_snapshot.cpp",
        "smart_config_manager.cpp",
    ],
    includes = ["//include"],
    deps = [
        "//include/utils:headers",
        "//src/logger:logger",
    ],
    copts = [
        "-std=c++20",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wno-uninitialized",
    ],
    linkopts = [
        "-stdlib=libc++",
        "-lc++abi",
    ],
    defines = [
        "SQLCC_MODERN_CPP=1",
        "SQLCC_CLANG18_FEATURES=1",
    ],
    visibility = ["//visibility:public"],
)
