# SQLCC核心组件Bazel构建配置

package(default_visibility = ["//visibility:public"])

# 核心库聚合（链接所有子库）
cc_library(
    name = "sqlcc_core",
    deps = [
        "//src/core:sqlcc_core_lib",
        "//src/core:sqlcc_permission_validator",
        "//src/sql_parser:sqlcc_parser",
        "//src/config_manager:sqlcc_config_manager",
        "//src/storage_engine:sqlcc_storage_engine",
        "//src/transaction_manager:sqlcc_transaction_manager",
        "//src/network:sqlcc_network",
        "//src/sql_executor:sqlcc_executor",
        ":unified_executor",
    ],
)

# Execution Context库
cc_library(
    name = "execution_context",
    srcs = ["execution_context.cpp"],
    hdrs = ["//include:core_headers"],
    includes = ["../include", "../include/core"],
    deps = [
        "//src/core:sqlcc_core_lib",
        "//src/storage_engine:sqlcc_storage_engine",
        "//src/config_manager:sqlcc_config_manager",
        "@com_google_absl//absl/strings",
    ],
)

# Execution Engine库
cc_library(
    name = "execution_engine",
    srcs = ["execution_engine.cpp"],
    hdrs = ["//include:core_headers"],
    includes = ["../include", "../include/core"],
    deps = [
        "//src/core:sqlcc_core_lib",
        "//src/storage_engine:sqlcc_storage_engine",
        "//src/config_manager:sqlcc_config_manager",
        ":execution_context",
        "@com_google_absl//absl/strings",
    ],
)

# Unified Executor库
cc_library(
    name = "unified_executor",
    srcs = ["unified_executor.cpp"],
    hdrs = ["//include:core_headers"],
    includes = ["../include", "../include/core", "../include/storage"],
    deps = [
        "//src/core:sqlcc_core_lib",
        "//src/core:sqlcc_database_manager",
        "//src/sql_parser:sqlcc_parser",
        "//src/sql_executor:sqlcc_executor",
        "//src/storage_engine:sqlcc_storage_engine",
        "//src/config_manager:sqlcc_config_manager",
        ":execution_engine",
        "@com_google_absl//absl/strings",
    ],
)



# 可执行文件
cc_binary(
    name = "sqlcc_server",
    srcs = ["sqlcc_server/server_main.cpp"],
    deps = [":sqlcc_core"],
)

cc_binary(
    name = "isql_client",
    srcs = ["bin/isql_main.cpp"],
    deps = [":sqlcc_core"],
)

