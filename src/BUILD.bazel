# //src/BUILD.bazel - 源代码包定义
# 包含所有源代码库的目标定义

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# ==================== 工具库 ====================

# Logger库 - 现代化日志系统 (包装器)
cc_library(
    name = "logger",
    deps = [
        "//src/logger:logger",
    ],
    visibility = ["//visibility:public"],
)

# Utils库 - 工具库 (包装器)
cc_library(
    name = "utils",
    deps = [
        "//src/utils:utils",
    ],
    visibility = ["//visibility:public"],
)

# ==================== 核心库 ====================

# Core库 - 核心组件 (包装器)
cc_library(
    name = "core",
    deps = [
        "//src/core:core",
        ":database_manager",
        ":execution_context",
        ":view_manager",
    ],
    visibility = ["//visibility:public"],
)
# Execution Context库 - 执行上下文管理
cc_library(
    name = "execution_context",
    srcs = ["execution_context.cpp"],
    deps = [
        "//src/core:core",
        "//src/core:database_manager",
    ],
    copts = [
        "-Iinclude",
    ],
    visibility = ["//visibility:public"],
)

# View Manager库 - 视图管理
cc_library(
    name = "view_manager",
    srcs = ["view_manager.cpp"],
    deps = [
        "//src/core:core",
        "//include:view_manager",
    ],
    copts = [
        "-Iinclude",
    ],
    visibility = ["//visibility:public"],
)

# Database Manager库 - 数据库管理器
cc_library(
    name = "database_manager",
    srcs = ["database_manager.cpp"],
    hdrs = ["//include:database_manager"],
    deps = [
        "//include/core:core_database_manager",
        "//include/storage:buffer_pool_sharded",
        "//include:page",
        "//include:disk_manager",
        "//include:exception",
        "//src/utils:utils",
        "//src/core:core",
    ],
    visibility = ["//visibility:public"],
)

# ==================== 存储引擎库 ====================

# StorageEngine库 - 智能指针存储引擎
cc_library(
    name = "storage_engine",
    deps = [
        "//src/storage_engine:storage_engine",
    ],
    visibility = ["//visibility:public"],
)

