# src/BUILD.bazel - SQLCC 源码包顶层聚合
# 包含所有源码库的目标定义和顶层工具

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary")

package(default_visibility = ["//src:__subpackages__"])

# ==================== 顶层胶水代码 ====================
cc_library(
    name = "src_root",
    srcs = [
        "database_manager.cpp",
        "dcl_executor.cpp",
        "execution_engine.cpp",
        "transaction_context_impl.cpp",
        "unified_executor.cpp",
        "unified_query_plan.cpp",
    ],
    deps = [
        "//src/core",
        "//src/sql_executor",
        "//src/storage_engine",
        "//src/transaction_manager",
        "//src/utils",
    ],
    visibility = ["//visibility:public"],
)

# ==================== 二进制工具 ====================
cc_binary(
    name = "isql",
    srcs = ["bin/isql_main.cpp"],
    deps = [
        "//src/sql_executor",
        "//src/network",
        "//src/utils",
    ],
)
