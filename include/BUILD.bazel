# 头文件库定义

package(default_visibility = ["//visibility:public"])

# 核心头文件库
filegroup(
    name = "core_headers",
    srcs = glob(["core/*.h"]),
)

# SQL解析器头文件库
filegroup(
    name = "sql_parser_headers",
    srcs = glob(["sql_parser/*.h"]),
)

# 网络头文件库
filegroup(
    name = "network_headers",
    srcs = glob(["network/*.h"]),
)

# 存储引擎头文件库
filegroup(
    name = "storage_engine_headers",
    srcs = glob(["storage/*.h"]),
)

# SQL执行器头文件库
filegroup(
    name = "sql_executor_headers",
    srcs = glob(["sql_executor/*.h"]),
)

# 配置管理器头文件库
filegroup(
    name = "config_manager_headers",
    srcs = glob(["utils/config_manager.h"]),
)

# 工具类库
cc_library(
    name = "utils_lib",
    hdrs = ["utils/file_descriptor.h"],
    includes = ["."],
    visibility = ["//visibility:public"],
)

# Execution头文件库
filegroup(
    name = "execution_headers",
    srcs = glob(["execution/*.h"]),
)

# 索引管理器头文件库
filegroup(
    name = "index_manager_headers",
    srcs = glob(["storage/index_manager.h"]),
)

# 根目录头文件库（包含不在子目录中的头文件）
filegroup(
    name = "root_headers",
    srcs = glob(["*.h"]),
)

# 错误处理头文件
filegroup(
    name = "error_handler_header",
    srcs = ["error_handler.h"],
)

# 事务管理器头文件
filegroup(
    name = "transaction_manager_headers",
    srcs = ["transaction_manager.h"],
)
