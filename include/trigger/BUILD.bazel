# SQLCC触发器模块头文件构建配置

package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_library")


# 导出头文件供其他包使用
exports_files([
    "trigger_definition.h",
    "trigger_executor.h",
    "recursion_guard.h",
    "trigger_manager.h",
    "sql_trigger_executor.h",
])

# 触发器模块头文件库
cc_library(
    name = "trigger_headers",
    hdrs = [
        "trigger_manager.h",
        "trigger_definition.h",
        "trigger_executor.h",
        "recursion_guard.h",
        "sql_trigger_executor.h",
    ],
)

# SQL触发器执行器头文件库
filegroup(
    name = "sql_trigger_executor",
    srcs = ["sql_trigger_executor.h"],
)
