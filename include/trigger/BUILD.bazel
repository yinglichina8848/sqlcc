# SQLCC触发器模块头文件构建配置

package(default_visibility = ["//visibility:public"])

load("@rules_cc//cc:defs.bzl", "cc_library")

# 触发器模块头文件库
cc_library(
    name = "trigger_headers",
    hdrs = [
        "trigger_manager.h",
    ],
    includes = ["."],
)

# SQL触发器执行器头文件库
filegroup(
    name = "sql_trigger_executor",
    srcs = ["sql_trigger_executor.h"],
)
