# Utils头文件库定义

package(default_visibility = ["//visibility:public"])

# Utils头文件库
filegroup(
    name = "utils_headers",
    srcs = glob(["*.h"]),
)

cc_library(
    name = "utils_lib",
    hdrs = glob(["*.h"]),
    includes = ["."],
    visibility = ["//visibility:public"],
)

# -----------------------------------------------------------------------------
# 综合头文件库 - 所有 utils 头文件的集合
# -----------------------------------------------------------------------------

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)
