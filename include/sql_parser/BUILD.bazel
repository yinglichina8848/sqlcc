# SQL解析器头文件库定义

package(default_visibility = ["//visibility:public"])

# SQL解析器头文件库
filegroup(
    name = "sqlcc_parser_headers",
    srcs = glob(["*.h"]),
)

cc_library(
    name = "ast_node",
    hdrs = ["ast_node.h"],
    includes = ["."],
)

cc_library(
    name = "ast_nodes",
    hdrs = ["ast_nodes.h"],
    includes = ["."],
)

cc_library(
    name = "node_visitor",
    hdrs = ["node_visitor.h"],
    includes = ["."],
)

cc_library(
    name = "function_ast",
    hdrs = ["function_ast.h"],
    includes = ["."],
)

cc_library(
    name = "function_definition",
    hdrs = ["function/function_definition.h"],
    includes = ["."],
)

cc_library(
    name = "set_operation",
    hdrs = ["set_operation.h"],
    includes = ["."],
)

cc_library(
    name = "window_function",
    hdrs = ["window_function.h"],
    includes = ["."],
)

cc_library(
    name = "recursive_query",
    hdrs = ["recursive_query.h"],
    includes = ["."],
)

cc_library(
    name = "token",
    hdrs = ["token.h"],
    includes = ["."],
)

cc_library(
    name = "constraint",
    hdrs = ["constraint.h"],
    includes = ["."],
)

cc_library(
    name = "data_types",
    hdrs = ["data_types.h"],
    includes = ["."],
)

cc_library(
    name = "datetime",
    hdrs = ["datetime.h"],
    includes = ["."],
)

cc_library(
    name = "decimal",
    hdrs = ["decimal.h"],
    includes = ["."],
)

# -----------------------------------------------------------------------------
# 综合头文件库 - 所有 sql_parser 头文件的集合
# -----------------------------------------------------------------------------

cc_library(
    name = "headers",
    hdrs = glob(["*.h", "**/*.h"]),
    includes = ["."],
    visibility = ["//visibility:public"],
)
