# SQL解析器头文件库定义

package(default_visibility = ["//visibility:public"])

# SQL解析器头文件库
filegroup(
    name = "sqlcc_parser_headers",
    srcs = glob(["*.h"]),
)

cc_library(
    name = "ast_node",
    hdrs = ["ast_node.h"],
)

cc_library(
    name = "ast_nodes",
    hdrs = ["ast_nodes.h"],
)

cc_library(
    name = "node_visitor",
    hdrs = ["node_visitor.h"],
)

cc_library(
    name = "function_ast",
    hdrs = ["function_ast.h"],
)

cc_library(
    name = "set_operation",
    hdrs = ["set_operation.h"],
)

cc_library(
    name = "window_function",
    hdrs = ["window_function.h"],
)

cc_library(
    name = "recursive_query",
    hdrs = ["recursive_query.h"],
)