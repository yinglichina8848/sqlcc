# SQL解析器头文件库定义

package(default_visibility = ["//visibility:public"])

# --------------------------
# AST 头文件库
# --------------------------
cc_library(
    name = "ast_headers",
    hdrs = [
        "ast_node.h",
        "ast_nodes.h",
        "ast_dcl_statements.h",
        "node_visitor.h",
        "load_data_ast.h",
        "ast_fwd.h",
    ],
    visibility = ["//src/sql_parser:__subpackages__"],
)

# --------------------------
# Lexer 头文件库
# --------------------------
cc_library(
    name = "lexer_headers",
    hdrs = [
        "token.h",
        "lexer_new.h",
    ],
    visibility = ["//src/sql_parser:__subpackages__"],
)

# --------------------------
# Parser 头文件库
# --------------------------
cc_library(
    name = "parser_headers",
    hdrs = [
        "parser.h",
        "set_operation.h",
        "recursive_query.h",
        "function_ast.h",
        "function/function_definition.h",
        "constraint.h",
        "data_types.h",
        "datetime.h",
        "decimal.h",
        "advanced_sql92_features.h",
    ],
    visibility = ["//src/sql_parser:__subpackages__"],
)

# --------------------------
# JSON 头文件库
# --------------------------
cc_library(
    name = "json_headers",
    hdrs = [
        "json.h",
        "json_parser.h",
        "json/json_value.h",
        "json/json_null.h",
        "json/json_boolean.h",
        "json/json_number.h",
        "json/json_string.h",
        "json/json_array.h",
        "json/json_object.h",
    ],
    visibility = ["//src/sql_parser:__subpackages__"],
)

# --------------------------
# Window Function 头文件库
# --------------------------
cc_library(
    name = "window_headers",
    hdrs = [
        "window_function.h",
    ],
    visibility = ["//src/sql_parser:__subpackages__"],
)

# --------------------------
# SQL解析器头文件库
# --------------------------
cc_library(
    name = "sql_parser_headers",
    hdrs = glob(["*.h", "**/*.h"]),
    visibility = ["//visibility:public"],
)

# --------------------------
# 向后兼容的综合头文件库
# --------------------------
cc_library(
    name = "headers",
    hdrs = glob(["*.h", "**/*.h"]),
    visibility = ["//visibility:public"],
)
